page {
  background-color: #1A1714;
  color: #E8DCC4;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text {
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-row {
  flex-direction: row;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.text-center {
  text-align: center;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.overflow-hidden {
  overflow: hidden;
}

.overflow-y-auto {
  overflow-y: auto;
}

.min-h-full {
  min-height: 100%;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.sticky {
  position: sticky;
}

.fixed {
  position: fixed;
}

.top-0 {
  top: 0;
}

.left-0 {
  left: 0;
}

.right-0 {
  right: 0;
}

.bottom-0 {
  bottom: 0;
}

.z-10 {
  z-index: 10;
}

.z-20 {
  z-index: 20;
}

.z-50 {
  z-index: 50;
}

/* 羊皮纸风格卡片 */
.parchment-card {
  background: linear-gradient(135deg, #E8DCC4 0%, #DFD0B0 100%);
  position: relative;
  color: #1A1714;
}

.parchment-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8"><rect width="2" height="2" fill="rgba(58,50,43,0.015)"/></svg>');
}

.ink-border {
  border: 1rpx solid rgba(15, 14, 12, 0.4);
  box-shadow: 0 0 0 1rpx rgba(232, 220, 196, 0.05) inset, 0 8px 24px -8px rgba(0,0,0,0.4);
}

/* 主题色变量 */
.page-bg {
  background-color: #1A1714;
}

.text-parchment {
  color: #E8DCC4;
}

.text-parchment-2 {
  color: rgba(232, 220, 196, 0.7);
}

.text-parchment-3 {
  color: rgba(232, 220, 196, 0.5);
}

.text-parchment-4 {
  color: rgba(232, 220, 196, 0.4);
}

.ink-700 {
  background-color: #2A2724;
}

.ink-800 {
  background-color: #221F1C;
}

.ink-900 {
  background-color: #1A1714;
}

.border-ink {
  border-color: rgba(232, 220, 196, 0.1);
}

