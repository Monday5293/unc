/* ============================================ */
/* 主题变量：深色（默认） / 浅色（.theme-light） */
/* 页面根节点绑定 class="xxx {{theme === 'light' ? 'theme-light' : ''}}" */
/* ============================================ */
page {
  /* 页面背景 */
  --page-bg: #1A1714;
  /* 卡片背景 */
  --card-bg: #221F1C;
  --card-bg-2: #2A2724;
  --card-bg-60: rgba(34, 31, 28, 0.6);
  /* 深色表面（banner、stat-card 等大面积底色） */
  --surface-40: rgba(26, 23, 20, 0.4);
  --surface-50: rgba(26, 23, 20, 0.5);
  --surface-60: rgba(26, 23, 20, 0.6);
  --surface-70: rgba(26, 23, 20, 0.7);
  --surface-80: rgba(26, 23, 20, 0.8);
  /* 主文字 */
  --text-main: #E8DCC4;
  --text-dim: #8B857E;
  /* 文字/边框半透明 */
  --text-03: rgba(232, 220, 196, 0.03);
  --text-04: rgba(232, 220, 196, 0.04);
  --text-05: rgba(232, 220, 196, 0.05);
  --text-06: rgba(232, 220, 196, 0.06);
  --text-08: rgba(232, 220, 196, 0.08);
  --text-10: rgba(232, 220, 196, 0.1);
  --text-12: rgba(232, 220, 196, 0.12);
  --text-15: rgba(232, 220, 196, 0.15);
  --text-16: rgba(232, 220, 196, 0.16);
  --text-18: rgba(232, 220, 196, 0.18);
  --text-20: rgba(232, 220, 196, 0.2);
  --text-25: rgba(232, 220, 196, 0.25);
  --text-30: rgba(232, 220, 196, 0.3);
  --text-35: rgba(232, 220, 196, 0.35);
  --text-40: rgba(232, 220, 196, 0.4);
  --text-45: rgba(232, 220, 196, 0.45);
  --text-50: rgba(232, 220, 196, 0.5);
  --text-55: rgba(232, 220, 196, 0.55);
  --text-60: rgba(232, 220, 196, 0.6);
  --text-65: rgba(232, 220, 196, 0.65);
  --text-70: rgba(232, 220, 196, 0.7);
  --text-80: rgba(232, 220, 196, 0.8);
  --text-85: rgba(232, 220, 196, 0.85);
  --text-90: rgba(232, 220, 196, 0.9);
  --text-95: rgba(232, 220, 196, 0.95);

  background-color: var(--page-bg);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 浅色模式：温暖纸张色 */
.theme-light {
  --page-bg: #F4EFE6;
  --card-bg: #FBF8F1;
  --card-bg-2: #EFE9DE;
  --card-bg-60: rgba(251, 248, 241, 0.85);
  --surface-40: rgba(120, 110, 95, 0.14);
  --surface-50: rgba(120, 110, 95, 0.18);
  --surface-60: rgba(120, 110, 95, 0.22);
  --surface-70: rgba(120, 110, 95, 0.26);
  --surface-80: rgba(120, 110, 95, 0.32);
  --text-main: #362F26;
  --text-dim: #8A8175;
  --text-03: rgba(54, 47, 38, 0.04);
  --text-04: rgba(54, 47, 38, 0.05);
  --text-05: rgba(54, 47, 38, 0.06);
  --text-06: rgba(54, 47, 38, 0.07);
  --text-08: rgba(54, 47, 38, 0.09);
  --text-10: rgba(54, 47, 38, 0.12);
  --text-12: rgba(54, 47, 38, 0.14);
  --text-15: rgba(54, 47, 38, 0.17);
  --text-16: rgba(54, 47, 38, 0.18);
  --text-18: rgba(54, 47, 38, 0.20);
  --text-20: rgba(54, 47, 38, 0.23);
  --text-25: rgba(54, 47, 38, 0.28);
  --text-30: rgba(54, 47, 38, 0.34);
  --text-35: rgba(54, 47, 38, 0.40);
  --text-40: rgba(54, 47, 38, 0.45);
  --text-45: rgba(54, 47, 38, 0.50);
  --text-50: rgba(54, 47, 38, 0.55);
  --text-55: rgba(54, 47, 38, 0.60);
  --text-60: rgba(54, 47, 38, 0.65);
  --text-65: rgba(54, 47, 38, 0.70);
  --text-70: rgba(54, 47, 38, 0.76);
  --text-80: rgba(54, 47, 38, 0.85);
  --text-85: rgba(54, 47, 38, 0.88);
  --text-90: rgba(54, 47, 38, 0.92);
  --text-95: rgba(54, 47, 38, 0.95);
}

view, text {
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-row {
  flex-direction: row;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.text-center {
  text-align: center;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.overflow-hidden {
  overflow: hidden;
}

.overflow-y-auto {
  overflow-y: auto;
}

.min-h-full {
  min-height: 100%;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.sticky {
  position: sticky;
}

.fixed {
  position: fixed;
}

.top-0 {
  top: 0;
}

.left-0 {
  left: 0;
}

.right-0 {
  right: 0;
}

.bottom-0 {
  bottom: 0;
}

.z-10 {
  z-index: 10;
}

.z-20 {
  z-index: 20;
}

.z-50 {
  z-index: 50;
}

/* 羊皮纸风格卡片 */
.parchment-card {
  background: linear-gradient(135deg, #E8DCC4 0%, #DFD0B0 100%);
  position: relative;
  color: #1A1714;
}

.parchment-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8"><rect width="2" height="2" fill="rgba(58,50,43,0.015)"/></svg>');
}

.ink-border {
  border: 1rpx solid rgba(15, 14, 12, 0.4);
  box-shadow: 0 0 0 1rpx var(--text-05) inset, 0 8px 24px -8px rgba(0,0,0,0.4);
}

/* 主题色变量 */
.page-bg {
  background-color: var(--page-bg);
}

.text-parchment {
  color: var(--text-main);
}

.text-parchment-2 {
  color: var(--text-70);
}

.text-parchment-3 {
  color: var(--text-50);
}

.text-parchment-4 {
  color: var(--text-40);
}

.ink-700 {
  background-color: var(--card-bg-2);
}

.ink-800 {
  background-color: var(--card-bg);
}

.ink-900 {
  background-color: var(--page-bg);
}

.border-ink {
  border-color: var(--text-10);
}

