/* ============================================ */
/* 通用小按钮（新增 + / 修改 ✎ / 取消 / 保存 / 删除） */
/* 所有页面、所有规则系统角色卡统一使用 */
/* ============================================ */
.section-edit-btns {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-edit-btn {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1.4;
  border: 1rpx solid;
  opacity: 0.7;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.section-edit-btn.primary {
  font-weight: 600;
  opacity: 1;
}

.section-edit-btn.delete-btn {
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  background: rgba(239, 68, 68, 0.1);
}
