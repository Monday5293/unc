.dynamic-form {
  padding: 8rpx 0;
}

.form-field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #2A2724;
}

.required-mark {
  color: #E74C3C;
  font-size: 22rpx;
}

.field-input {
  width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background-color: rgba(26, 23, 20, 0.06);
  border: 1rpx solid rgba(26, 23, 20, 0.15);
  font-size: 28rpx;
  color: #1A1714;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background-color: rgba(26, 23, 20, 0.06);
  border: 1rpx solid rgba(26, 23, 20, 0.15);
  font-size: 28rpx;
  color: #1A1714;
  box-sizing: border-box;
  line-height: 1.6;
}

.field-select {
  width: 100%;
  border-radius: 12rpx;
  background-color: rgba(26, 23, 20, 0.06);
  border: 1rpx solid rgba(26, 23, 20, 0.15);
}

.select-value {
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1A1714;
}

.placeholder-text {
  color: rgba(26, 23, 20, 0.4);
}

.field-placeholder {
  color: rgba(26, 23, 20, 0.4);
}

/* ===== Image ===== */
.field-image {
  width: 100%;
  border-radius: 12rpx;
  background-color: rgba(26, 23, 20, 0.04);
}

/* ===== Counter (inputNumber) ===== */
.field-counter {
  display: flex;
  align-items: center;
  gap: 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.15);
  overflow: hidden;
  background-color: rgba(26, 23, 20, 0.06);
}

.counter-btn {
  width: 80rpx;
  height: 80rpx;
  min-width: 80rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  color: #1A1714;
  background-color: rgba(26, 23, 20, 0.06);
  flex-shrink: 0;
}

.counter-input {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 8rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1A1714;
  background-color: transparent;
  border-left: 1rpx solid rgba(26, 23, 20, 0.1);
  border-right: 1rpx solid rgba(26, 23, 20, 0.1);
}

.counter-btn-sm {
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  min-height: 60rpx;
  font-size: 28rpx;
}

.counter-input-sm {
  height: 60rpx;
  min-height: 60rpx;
  font-size: 24rpx;
}

/* ===== Image in grid cell ===== */
.grid-cell-image {
  width: 100%;
  border-radius: 8rpx;
}

/* ===== Counter in grid cell ===== */
.grid-cell-counter {
  display: flex;
  align-items: center;
  gap: 0;
  border-radius: 8rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  overflow: hidden;
  background-color: rgba(26, 23, 20, 0.04);
  width: 100%;
}

/* ===== Radio ===== */
.field-radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.15);
  background-color: rgba(26, 23, 20, 0.04);
}

.radio-item.radio-active {
  border-color: #C8A046;
  background-color: rgba(200, 160, 70, 0.1);
}

.radio-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(26, 23, 20, 0.3);
  box-sizing: border-box;
}

.radio-dot-active {
  border-color: #C8A046;
  background-color: #C8A046;
  box-shadow: inset 0 0 0 4rpx #fff;
}

.radio-label {
  font-size: 26rpx;
  color: #1A1714;
}

/* ===== Checkbox ===== */
.field-checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.15);
  background-color: rgba(26, 23, 20, 0.04);
}

.checkbox-box {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  border: 2rpx solid rgba(26, 23, 20, 0.3);
  box-sizing: border-box;
}

.checkbox-check {
  font-size: 20rpx;
  color: #C8A046;
  font-weight: bold;
}

.checkbox-label {
  font-size: 26rpx;
  color: #1A1714;
}

/* ===== Switch ===== */
.field-switch-wrap {
  padding: 8rpx 0;
}

/* ===== Slider ===== */
.field-slider-wrap {
  padding: 8rpx 0;
}

/* ===== Rate ===== */
.field-rate {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.rate-stars {
  display: flex;
  gap: 4rpx;
}

.rate-star {
  font-size: 40rpx;
  color: rgba(26, 23, 20, 0.15);
  line-height: 1;
}

.rate-star-active {
  color: #C8A046;
}

.rate-value {
  font-size: 24rpx;
  color: rgba(26, 23, 20, 0.5);
}

/* ===== ColorPicker ===== */
.field-color-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.color-preview {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.15);
  flex-shrink: 0;
}

.field-color-wrap .field-input {
  flex: 1;
}

/* ===== Group / Object ===== */
.field-group {
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  overflow: hidden;
}

.group-header {
  padding: 16rpx 24rpx;
  background-color: rgba(26, 23, 20, 0.04);
  border-bottom: 1rpx solid rgba(26, 23, 20, 0.08);
}

.group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2724;
}

.group-body {
  padding: 16rpx 24rpx;
}

.group-empty {
  font-size: 24rpx;
  color: rgba(26, 23, 20, 0.4);
}

/* ===== Table (fcTable) ===== */
.field-table {
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  overflow: hidden;
}

.table-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: rgba(26, 23, 20, 0.04);
  border-bottom: 1rpx solid rgba(26, 23, 20, 0.08);
}

.table-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2724;
}

.table-add-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #C8A046;
}

.table-add-icon {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.table-add-text {
  font-size: 22rpx;
  color: #fff;
}

.table-scroll {
  width: 100%;
}

.table-wrap {
  min-width: max-content;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid rgba(26, 23, 20, 0.06);
}

.table-row:last-child {
  border-bottom: none;
}

.table-head-row {
  background-color: rgba(26, 23, 20, 0.03);
}

.table-cell {
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #1A1714;
  box-sizing: border-box;
}

.table-head-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #2A2724;
}

.table-action-cell {
  min-width: 100rpx !important;
  flex: none !important;
  text-align: center;
}

.table-input {
  width: 100%;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  background-color: rgba(26, 23, 20, 0.04);
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  font-size: 22rpx;
  color: #1A1714;
  box-sizing: border-box;
}

.table-select {
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  background-color: rgba(26, 23, 20, 0.04);
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  font-size: 22rpx;
  color: #1A1714;
}

.table-remove-btn {
  font-size: 22rpx;
  color: #E74C3C;
}

.table-empty {
  padding: 32rpx;
  text-align: center;
}

.table-empty-text {
  font-size: 24rpx;
  color: rgba(26, 23, 20, 0.4);
}

/* ===== 栅格行布局 (fcRow) ===== */
.field-row-layout {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.row-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 布局网格 (fcTable as layout grid) ===== */
.field-grid-layout {
  display: grid;
  gap: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  padding: 16rpx;
  background-color: rgba(26, 23, 20, 0.02);
}
.field-grid-nested {
  border: none;
  padding: 0;
  background-color: transparent;
  gap: 8rpx;
}
.grid-cell {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background-color: rgba(26, 23, 20, 0.04);
  border: 1rpx solid rgba(26, 23, 20, 0.08);
  min-height: 60rpx;
}
.grid-cell-text {
  font-size: 26rpx;
  color: #2A2724;
  font-weight: 500;
}
/* ===== 字段描述 ===== */
.field-info {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(26, 23, 20, 0.4);
}