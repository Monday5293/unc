<view
  class="card-item parchment-card ink-border {{pressing ? 'pressing' : ''}}"
  style="--accent: {{system.accentColor}}; --border-color: {{borderColor}}"
  hover-class="none"
  bindtap="onClickCard"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchCancel"
>
  <view class="accent-bar" style="background-color: {{system.accentColor}}"></view>

  <view class="fav-btn" catchtap="onToggleFav">
    <text wx:if="{{card.favorite}}" class="fav-icon active" style="color: {{system.accentColor}}">★</text>
    <text wx:else class="fav-icon" style="color: var(--text-25)">☆</text>
  </view>

  <view class="card-header">
    <view class="card-avatar" style="background-color: {{system.accentColor}}22; box-shadow: 0 0 0 1px {{system.accentColor}}55 inset">
      <text wx:if="{{!card.avatar}}" class="avatar-text">{{system.logo}}</text>
      <image wx:else src="{{card.avatar}}" class="avatar-img" mode="aspectFill"></image>
    </view>
    <view class="card-info">
      <text class="card-name">{{displayName}}</text>
      <text class="card-player">{{displayPlayer}}</text>
    </view>
  </view>

  <view class="card-desc" wx:if="{{displayDescription}}">{{displayDescription}}</view>

  <view class="card-fields">
    <view wx:for="{{profileFields}}" wx:key="label" class="field-tag">
      <text class="field-label">{{item.label}}</text>
      <text class="field-value">{{item.value}}</text>
    </view>
  </view>
</view>
