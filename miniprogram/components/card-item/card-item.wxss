.card-item {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 24rpx;
  padding: 24rpx;
  color: var(--text-main);
  border: 2rpx solid var(--border-color);
}

.card-item.pressing {
  opacity: 0.85;
}

.accent-bar {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 12rpx;
}

.fav-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: transparent;
}

.fav-icon {
  font-size: 32rpx;
  color: var(--text-main);
}

.fav-icon.active {
  /* 颜色通过内联 style 设置 */
}

.card-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.card-avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
}

.avatar-text {
  font-size: 48rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.card-info {
  min-width: 0;
  flex: 1;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-player {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-70);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  position: relative;
  z-index: 1;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-70);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-fields {
  position: relative;
  z-index: 1;
  margin-top: auto;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.field-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background-color: transparent;
  font-size: 18rpx;
  font-weight: 500;
}

.field-label {
  color: var(--text-60);
}

.field-value {
  color: var(--text-main);
}

.field-value-sub {
  display: block;
  color: var(--text-main);
  font-size: 18rpx;
}
