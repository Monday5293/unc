.card-item {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 24rpx;
  padding: 32rpx;
  color: #1A1714;
}

.card-item.pressing {
  transform: scale(0.98);
}

.accent-bar {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 12rpx;
}

.fav-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(26, 23, 20, 0.1);
}

.fav-icon {
  font-size: 32rpx;
  color: #1A1714;
}

.fav-icon.active {
  /* 颜色通过内联 style 设置 */
}

.card-header {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.card-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
}

.avatar-text {
  font-size: 48rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.card-info {
  min-width: 0;
  flex: 1;
}

.card-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1714;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-player {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(26, 23, 20, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(26, 23, 20, 0.7);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-fields {
  margin-top: auto;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.field-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: rgba(26, 23, 20, 0.08);
  font-size: 20rpx;
  font-weight: 500;
}

.field-label {
  color: rgba(26, 23, 20, 0.7);
}

.field-value {
  color: #1A1714;
}
