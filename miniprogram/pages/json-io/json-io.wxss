.json-io-page {
  min-height: 100vh;
  background-color: #1A1714;
  padding: 32rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background-color: rgba(34, 31, 28, 0.6);
  border: 1rpx solid rgba(232, 220, 196, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #E8DCC4;
  margin-bottom: 24rpx;
}

.type-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.type-tab {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.6);
}

.type-tab.active {
  background-color: rgba(200, 160, 70, 0.15);
  border-color: rgba(200, 160, 70, 0.4);
  color: #C8A046;
  font-weight: 500;
}

.input-section {
  margin-bottom: 24rpx;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.input-label {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.6);
}

.input-actions {
  display: flex;
  gap: 24rpx;
}

.action-link {
  font-size: 22rpx;
  color: #C8A046;
}

.action-link.danger {
  color: #F87171;
}

.json-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #1A1714;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  font-size: 24rpx;
  color: #E8DCC4;
  font-family: monospace;
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: rgba(232, 220, 196, 0.3);
}

.action-btn {
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.primary {
  background-color: #C8A046;
  color: #1A1714;
}

.action-btn.secondary {
  background-color: rgba(200, 160, 70, 0.1);
  border: 1rpx solid rgba(200, 160, 70, 0.4);
  color: #C8A046;
}

.select-section {
  margin-bottom: 24rpx;
}

.select-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.6);
}

.picker-value {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background-color: #1A1714;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  font-size: 28rpx;
  color: #E8DCC4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  font-size: 32rpx;
  color: rgba(232, 220, 196, 0.4);
}

.export-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  line-height: 1.5;
}
