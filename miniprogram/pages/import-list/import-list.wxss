.import-page {
  min-height: 100vh;
  background-color: #1A1714;
}

.info-banner {
  padding: 24rpx 32rpx;
  background-color: rgba(59, 107, 74, 0.1);
  border-bottom: 1rpx solid rgba(232, 220, 196, 0.1);
}

.info-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(232, 220, 196, 0.7);
}

.info-title {
  font-weight: 600;
  color: #3B6B4A;
}

.content {
  padding: 24rpx 32rpx 48rpx;
}

.loading-state,
.error-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 128rpx 40rpx;
}

.loading-icon,
.error-icon,
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.loading-icon {
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.loading-text {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.4);
}

.error-icon {
  opacity: 0.6;
}

.error-text {
  font-size: 24rpx;
  color: #F87171;
  margin-bottom: 8rpx;
}

.error-hint {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #3B6B4A;
  font-size: 24rpx;
  color: #3B6B4A;
}

.empty-icon {
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.3);
}

.form-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  color: #1A1714;
}

.form-icon {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 40rpx;
}

.form-info {
  min-width: 0;
  flex: 1;
}

.form-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.form-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1714;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-system-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 500;
}

.form-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 22rpx;
  color: rgba(26, 23, 20, 0.7);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.form-meta {
  display: flex;
  gap: 24rpx;
  font-size: 20rpx;
  color: rgba(26, 23, 20, 0.6);
}

.import-btn {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background-color: #1A1714;
}

.import-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #E8DCC4;
  white-space: nowrap;
}

.importing {
  font-size: 20rpx;
  color: #C8A046;
  white-space: nowrap;
}

.import-actions {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(232, 220, 196, 0.1);
}

.import-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx dashed rgba(200, 160, 70, 0.4);
  background-color: rgba(200, 160, 70, 0.08);
}

.import-action-icon {
  font-size: 32rpx;
}

.import-action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #C8A046;
}

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(26, 23, 20, 0.8);
  padding: 48rpx;
}

.dialog-box {
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  background-color: #221F1C;
  box-shadow: 0 32rpx 64rpx -16rpx rgba(0, 0, 0, 0.5);
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid rgba(232, 220, 196, 0.1);
}

.dialog-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8DCC4;
}

.dialog-close {
  font-size: 28rpx;
  color: rgba(232, 220, 196, 0.4);
}

.dialog-body {
  padding: 32rpx 40rpx;
}

.json-source-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.json-source-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  background-color: rgba(26, 23, 20, 0.4);
}

.json-source-icon {
  font-size: 28rpx;
}

.json-source-text {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.7);
}

.input-section {
  margin-bottom: 24rpx;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.input-label {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.6);
}

.input-clear {
  font-size: 22rpx;
  color: #F87171;
}

.json-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #1A1714;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  font-size: 22rpx;
  color: #E8DCC4;
  font-family: monospace;
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: rgba(232, 220, 196, 0.3);
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-cancel {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(232, 220, 196, 0.2);
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.7);
}

.btn-primary {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background-color: #C8A046;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1714;
}

.btn-primary.disabled {
  opacity: 0.5;
}

/* ===== 预览角色卡弹窗 ===== */
.preview-dialog {
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  background-color: #221F1C;
  box-shadow: 0 32rpx 64rpx -16rpx rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
}

.preview-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid rgba(232, 220, 196, 0.1);
  flex-shrink: 0;
}

.preview-dialog-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8DCC4;
}

.preview-scroll {
  flex: 1;
  overflow-y: auto;
}

.preview-card {
  background-color: #1A1714;
  border-radius: 0;
}

.preview-card-header {
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid rgba(232, 220, 196, 0.08);
}

.preview-header-deco {
  font-size: 48rpx;
  text-align: center;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.preview-card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.preview-card-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 40rpx;
  color: #E8DCC4;
}

.preview-card-info {
  flex: 1;
  min-width: 0;
}

.preview-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #E8DCC4;
  display: block;
  margin-bottom: 4rpx;
}

.preview-card-player {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.5);
}

.preview-system-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.preview-form-wrap {
  padding: 24rpx 32rpx;
}

/* JSON 编辑区 */
.preview-json-section {
  padding: 0 32rpx 24rpx;
}

.json-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
}

.json-toggle-icon {
  font-size: 20rpx;
  color: rgba(200, 160, 70, 0.7);
}

.json-toggle-text {
  font-size: 22rpx;
  color: #C8A046;
}

.json-editor-wrap {
  margin-top: 8rpx;
}

.preview-textarea {
  min-height: 300rpx;
  max-height: 500rpx;
}

.preview-dialog-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 24rpx 40rpx;
  border-top: 1rpx solid rgba(232, 220, 196, 0.1);
  flex-shrink: 0;
}
