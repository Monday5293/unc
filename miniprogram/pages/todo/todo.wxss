.todo-page {
  min-height: 100vh;
  background-color: var(--page-bg);
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.todo-header {
  margin-bottom: 24rpx;
}

.todo-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.todo-input {
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 0 24rpx;
  color: #E8E4DD;
  font-size: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.todo-input-placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.todo-add-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #C8A046;
  color: #1A1714;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.todo-add-btn.disabled {
  background: rgba(200, 160, 70, 0.3);
  color: rgba(26, 23, 20, 0.4);
}

.todo-stats {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.todo-stats-text {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

.todo-stats-text.done {
  color: #6B8E6B;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.2s;
}

.todo-item.done {
  opacity: 0.5;
}

.todo-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.todo-item.done .todo-check {
  background: #6B8E6B;
  border-color: #6B8E6B;
}

.todo-check-icon {
  color: #1A1714;
  font-size: 24rpx;
  font-weight: bold;
}

.todo-title {
  flex: 1;
  color: #E8E4DD;
  font-size: 28rpx;
  line-height: 1.4;
}

.todo-item.done .todo-title {
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.35);
}

.todo-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0;
  transition: opacity 0.2s;
}

.todo-item:hover .todo-delete,
.todo-item:active .todo-delete {
  opacity: 1;
}

.todo-delete-icon {
  color: rgba(255, 255, 255, 0.3);
  font-size: 24rpx;
}

.todo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.todo-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.todo-empty-text {
  color: rgba(255, 255, 255, 0.4);
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.todo-empty-hint {
  color: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
}