<view class="card-list-page {{theme === 'light' ? 'theme-light' : ''}}">
  <view class="list-header">
    <text class="list-title">{{title}}</text>
    <text class="list-count">共 {{totalCount}} 张</text>
  </view>

  <view wx:if="{{groupedCards.length === 0}}" class="empty-state">
    <text class="empty-icon">{{type === 'favorites' ? '☆' : '📭'}}</text>
    <text class="empty-text">{{type === 'favorites' ? '暂无收藏的角色卡' : '暂无角色卡'}}</text>
  </view>

  <view wx:for="{{groupedCards}}" wx:for-item="group" wx:key="system" class="card-group">
    <view class="group-header" style="color: {{group.accent}}">
      <text class="group-logo">{{group.logo}}</text>
      <text class="group-name">{{group.name}}</text>
      <text class="group-count">· {{group.items.length}}</text>
    </view>
    <view class="group-list">
      <view
        wx:for="{{group.items}}"
        wx:for-item="card"
        wx:key="id"
        class="card-row"
        data-id="{{card.id}}"
        bindtap="openCard"
      >
        <view class="card-row-icon" style="background-color: {{group.accent}}22;">
          <image wx:if="{{card.avatar}}" src="{{card.avatar}}" class="card-row-avatar" mode="aspectFill"></image>
          <text wx:else>{{group.logo}}</text>
        </view>
        <view class="card-row-info">
          <view class="card-row-name-row">
            <text class="card-row-name">{{card.name}}</text>
            <text wx:if="{{card.favorite}}" class="card-fav" style="color: {{group.accent}}">★</text>
          </view>
          <view class="card-row-fields">
            <view wx:for="{{card.fields}}" wx:for-item="f" wx:key="label" class="card-field-tag">
              <text class="card-field-label">{{f.label}}</text>
              <text class="card-field-value">{{f.value}}</text>
            </view>
          </view>
        </view>
        <text class="card-row-arrow">›</text>
      </view>
    </view>
  </view>
</view>
