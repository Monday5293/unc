<view class="profile-page">
  <view class="profile-header">
    <view class="header-glow"></view>
    <view class="user-section">
      <view class="user-avatar">
        <image wx:if="{{userAvatar}}" src="{{userAvatar}}" class="avatar-img" mode="aspectFill"></image>
        <text wx:else class="avatar-placeholder">🧙</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userName}}</text>
        <text class="user-desc">跑团旅人 · ID #TRPG-2026</text>
        <view class="system-tags">
          <view
            wx:for="{{systems}}"
            wx:key="code"
            class="system-tag"
            style="color: {{item.accentColor}}; background-color: {{item.accentColor}}22;"
          >
            {{item.logo}} {{item.name}}
          </view>
        </view>
      </view>
    </view>

    <view class="stats-grid">
      <view
        wx:for="{{topStats}}"
        wx:key="label"
        class="stat-card"
      >
        <text class="stat-value" style="color: {{item.color}}">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="profile-content">
    <view class="section">
      <view class="section-header">
        <text class="section-title">我的角色卡</text>
        <view class="section-more" bindtap="goHome">
          查看全部 ›
        </view>
      </view>

      <view wx:for="{{groupedMyCards}}" wx:for-item="group" wx:key="system" class="card-group">
        <view class="group-header" style="color: {{group.accent}}">
          <text class="group-logo">{{group.logo}}</text>
          <text class="group-name">{{group.name}}</text>
          <text class="group-count">· {{group.items.length}}</text>
        </view>
        <view class="group-list">
          <view
            wx:for="{{group.items}}"
            wx:for-item="card"
            wx:key="id"
            class="card-row"
            data-id="{{card.id}}"
            bindtap="openCard"
          >
            <view class="card-row-icon" style="background-color: {{group.accent}}22;">
              {{group.logo}}
            </view>
            <view class="card-row-info">
              <view class="card-row-name-row">
                <text class="card-row-name">{{card.name}}</text>
                <text wx:if="{{card.favorite}}" class="card-fav" style="color: {{group.accent}}">★</text>
              </view>
              <text class="card-row-desc">{{card.description}}</text>
            </view>
            <text class="card-row-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="menu-list">
        <view class="menu-item" bindtap="goDesigner">
          <text class="menu-icon">🛠️</text>
          <view class="menu-info">
            <text class="menu-title">网页表单设计器</text>
            <text class="menu-desc">制作 COC / DND 表单模板</text>
          </view>
          <text class="menu-arrow">↗</text>
        </view>

        <view class="menu-item" bindtap="goImport">
          <text class="menu-icon">📥</text>
          <view class="menu-info">
            <text class="menu-title import">读取服务器表单 JSON</text>
            <text class="menu-desc">下载设计器保存的表单并渲染</text>
          </view>
          <text class="menu-arrow">↗</text>
        </view>

        <view class="menu-item" bindtap="goJsonIO">
          <text class="menu-icon">📦</text>
          <view class="menu-info">
            <text class="menu-title">导入 / 导出 JSON</text>
            <text class="menu-desc">规则系统、角色卡数据备份</text>
          </view>
          <text class="menu-arrow">↗</text>
        </view>

        <view class="menu-item" bindtap="goSettings">
          <text class="menu-icon">⚙️</text>
          <view class="menu-info">
            <text class="menu-title">设置</text>
            <text class="menu-desc">主题、字体、深色模式</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>

        <view class="menu-item" bindtap="goAbout">
          <text class="menu-icon">📖</text>
          <view class="menu-info">
            <text class="menu-title">关于</text>
            <text class="menu-desc">v1.0.0 · 跑团角色卡</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
