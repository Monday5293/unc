page {
  background-color: var(--page-bg);
}

.profile-page {
  min-height: 100vh;
  background-color: var(--page-bg);
}

.profile-header {
  position: relative;
  overflow: hidden;
  padding: 64rpx 40rpx 48rpx;
  background: linear-gradient(180deg, var(--card-bg) 0%, var(--page-bg) 100%);
}

.header-glow {
  position: absolute;
  top: -80rpx;
  right: 0;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 160, 70, 0.3) 0%, transparent 70%);
  opacity: 0.6;
}

/* ===== 未登录状态 ===== */
.user-desc-hint {
  color: var(--text-30);
  font-size: 20rpx;
}

.user-section {
  position: relative;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  border: 4rpx solid #C8A046;
  background-color: var(--card-bg-2);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 48rpx;
}

.user-info {
  min-width: 0;
  flex: 1;
}

/* 名称行 */
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.name-edit-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: var(--text-08);
}

.name-edit-btn:active {
  background: var(--text-16);
}

.name-edit-icon {
  font-size: 24rpx;
  color: var(--text-50);
}

/* 名称编辑行 */
.name-edit-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.name-input {
  flex: 1;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: var(--text-08);
  color: var(--text-main);
  font-size: 28rpx;
}

.name-confirm-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #C8A046;
  color: #1A1714;
  font-size: 24rpx;
  font-weight: 700;
}

.name-cancel-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: var(--text-08);
  color: var(--text-50);
  font-size: 24rpx;
}

.user-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-50);
  margin-top: 4rpx;
}

/* 统计卡片 - 2列 */
.stats-grid {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.stat-card {
  flex: 1;
  padding: 32rpx 8rpx;
  border-radius: 16rpx;
  background-color: transparent;
  border: 1rpx solid var(--text-10);
  text-align: center;
}

.stat-card:active {
  background-color: rgba(200, 160, 70, 0.08);
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.stat-value-all {
  color: #C8A046;
}

.stat-value-fav {
  color: #3B6B4A;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-50);
}

.profile-content {
  padding: 32rpx 32rpx 48rpx;
}

.section {
  margin-bottom: 32rpx;
}

.menu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background-color: var(--card-bg-60);
  border: 1rpx solid var(--text-10);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--text-08);
}

.menu-item:last-child {
  border-bottom: none;
}

/* ===== 退出登录按钮 ===== */
.logout-section {
  padding: 32rpx 32rpx 48rpx;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(239, 68, 68, 0.12);
  border: 1rpx solid rgba(239, 68, 68, 0.25);
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 500;
}

.menu-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-info {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.menu-desc {
  display: block;
  font-size: 20rpx;
  color: var(--text-40);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-40);
  flex-shrink: 0;
}

/* ===== 手机号登录弹窗 ===== */
.login-dialog {
  width: 85vw;
  max-width: 560rpx;
  background: var(--page-bg);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 32rpx 0 0;
}

.login-dialog .dialog-body {
  padding: 24rpx 36rpx 32rpx;
}

.login-dialog .dialog-header {
  padding: 0 36rpx 16rpx;
}

.login-field {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.login-field-label {
  font-size: 26rpx;
  color: var(--text-60);
  flex-shrink: 0;
  width: 64rpx;
  text-align: left;
}

.login-field-input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: var(--text-08);
  color: var(--text-main);
  font-size: 26rpx;
}

.login-dialog-confirm-btn {
  width: 320rpx !important;
  height: 68rpx !important;
  line-height: 68rpx !important;
  text-align: center;
  border-radius: 12rpx !important;
  background: #C8A046 !important;
  color: #1A1714 !important;
  font-size: 28rpx !important;
  font-weight: 600;
  border: none !important;
  padding: 0 !important;
}

.login-dialog-confirm-btn::after {
  border: none !important;
}

.login-dialog-btn-wrap {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.login-toggle {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(200, 160, 70, 0.6);
}

/* ===== 头像裁剪弹窗（复用 card-detail 样式） ===== */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.crop-dialog-box {
  width: 85vw;
  background: var(--page-bg);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid var(--text-08);
}

.dialog-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C8A046;
}

.dialog-close {
  font-size: 32rpx;
  color: var(--text-40);
  padding: 0 8rpx;
}

.crop-body {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  overflow: hidden;
}

.crop-canvas-area {
  position: relative;
  overflow: hidden;
  background: #000;
}

.crop-image {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
}

.crop-movable-area {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
}

.crop-movable-box {
  border: 2rpx solid #C8A046;
  box-sizing: border-box;
}

.crop-movable-circle {
  border-radius: 50%;
}

.crop-grid-line-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(200, 160, 70, 0.5);
}

.crop-grid-line-h1 { top: 33.33%; }
.crop-grid-line-h2 { top: 66.66%; }

.crop-grid-line-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(200, 160, 70, 0.5);
}

.crop-grid-line-v1 { left: 33.33%; }
.crop-grid-line-v2 { left: 66.66%; }

.crop-actions {
  padding: 0 28rpx 24rpx;
}

.crop-resize-handle {
  position: absolute;
  width: 32px;
  height: 32px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.crop-resize-icon {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 3px solid #C8A046;
  background: var(--surface-80);
}

.crop-canvas-hidden {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 300px;
  height: 300px;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-50);
  border: 1rpx solid var(--text-15);
  background: var(--text-06);
}

.btn-primary {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1714;
  background: #C8A046;
}
