<view class="custom-form-page" wx:if="{{card && systemInfo}}">
  <view class="detail-header" style="background: linear-gradient(180deg, {{accentColor}}22 0%, transparent 100%);">
    <view class="header-decoration">{{systemInfo.logo}}</view>

    <view class="header-content">
      <view class="system-badge-row">
        <view class="system-badge" style="color: {{accentColor}}; background-color: {{accentColor}}22;">
          {{systemInfo.logo}} {{systemInfo.fullName}}
        </view>
        <text class="custom-tag">· 来自服务器导入</text>
      </view>

      <text class="form-title">{{card.name}}</text>

      <view wx:if="{{card.description}}" class="form-desc" style="border-color: {{accentColor}};">
        {{card.description}}
      </view>

      <view class="field-count">
        字段数：{{rule.length}}
      </view>
    </view>
  </view>

  <view class="detail-content">
    <view class="section-header">
      <text class="section-title" style="color: {{accentColor}};">表单渲染</text>
      <view class="title-line"></view>
    </view>

    <view class="form-container parchment-card ink-border">
      <dynamic-form
        rule="{{rule}}"
        value="{{formData}}"
        bind:change="onFormChange"
      />
    </view>
  </view>
</view>

<view wx:elif="{{loading}}" class="loading-state">
  <text class="loading-icon">⏳</text>
  <text class="loading-text">加载表单中...</text>
</view>

<view wx:elif="{{loadError}}" class="error-state">
  <text class="error-icon">⚠️</text>
  <text class="error-title">加载失败</text>
  <text class="error-desc">{{loadError}}</text>
  <view class="retry-btn" bindtap="loadForm">重试</view>
</view>

<view wx:elif="{{!card}}" class="empty-state">
  <text class="empty-icon">📭</text>
  <text class="empty-text">未找到表单数据</text>
  <text class="empty-hint">可能已被清除，请返回列表重新下载</text>
  <view class="back-btn" bindtap="goBack">返回列表</view>
</view>
