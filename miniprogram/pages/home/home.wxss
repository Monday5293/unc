page {
  background-color: var(--page-bg);
}

.home-page {
  min-height: 100vh;
  background-color: var(--page-bg);
  display: flex;
  flex-direction: column;
}

.header {
  position: sticky;
  top: 0;
  z-index: 20;
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--text-10);
  background-color: var(--page-bg);
  }

.header-top {
  padding: 24rpx 32rpx 0;
}

.header-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
}

.system-tag {
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.search-section {
  padding: 16rpx 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background-color: var(--card-bg);
  border: 1rpx solid var(--text-10);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-main);
}

.search-placeholder {
  color: var(--text-30);
}

.search-clear {
  font-size: 20rpx;
  color: var(--text-40);
}

.tab-section {
  padding: 0 32rpx 16rpx;
}

.content {
  flex: 1;
  padding: 32rpx 24rpx;
}

.content-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-count {
  font-size: 22rpx;
  color: var(--text-50);
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(200, 160, 70, 0.4);
  background-color: rgba(200, 160, 70, 0.1);
}

.add-icon {
  font-size: 24rpx;
  color: #C8A046;
  font-weight: 300;
}

.add-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #C8A046;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding-bottom: 32rpx;
}

.card-grid-item {
  /* grid 自动处理列宽，无需额外宽度规则 */
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
}

.empty-logo {
  font-size: 80rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-40);
  margin-bottom: 24rpx;
}

.empty-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #C8A046;
  font-size: 24rpx;
  color: #C8A046;
}

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--surface-80);
  padding: 48rpx;
}

.dialog-box {
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid var(--text-15);
  background-color: var(--card-bg);
  box-shadow: 0 32rpx 64rpx -16rpx rgba(0, 0, 0, 0.5);
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid var(--text-10);
}

.dialog-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.dialog-close {
  font-size: 28rpx;
  color: var(--text-40);
}

.dialog-body {
  padding: 40rpx;
}

.dialog-tip {
  padding: 24rpx;
  border-radius: 12rpx;
  background-color: var(--surface-60);
  font-size: 22rpx;
  color: var(--text-50);
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--text-60);
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background-color: var(--page-bg);
  border: 1rpx solid var(--text-15);
  font-size: 28rpx;
  line-height: 80rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background-color: var(--page-bg);
  border: 1rpx solid var(--text-15);
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.input-placeholder {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-35);
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
}

.btn-cancel {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--text-20);
  font-size: 24rpx;
  color: var(--text-70);
}

.btn-primary {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background-color: #C8A046;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1714;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.dialog-danger {
  border-color: rgba(220, 38, 38, 0.3);
}

.dialog-body.text-center {
  text-align: center;
}

.dialog-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.dialog-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-50);
}

.dialog-bottom-actions {
  display: flex;
  border-top: 1rpx solid var(--text-10);
}

.bottom-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-70);
  border-right: 1rpx solid var(--text-10);
}

.bottom-btn:last-child {
  border-right: none;
}

.bottom-btn.danger {
  color: #F87171;
  font-weight: 600;
}

.action-sheet {
  max-width: 600rpx;
}

.action-header {
  position: relative;
  padding: 64rpx 40rpx 48rpx;
  text-align: center;
}

.action-header .dialog-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
}

.action-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-size: 80rpx;
}

.action-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.action-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--text-40);
}

.action-list {
  padding: 0 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
}

.action-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.action-icon-wrap.export {
  background-color: rgba(200, 160, 70, 0.1);
}

.action-icon-wrap.delete {
  background-color: rgba(220, 38, 38, 0.2);
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.action-name.danger {
  color: #F87171;
}

.action-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-40);
}

.action-arrow {
  font-size: 32rpx;
  color: var(--text-30);
}

.action-cancel {
  padding: 24rpx;
  text-align: center;
  border-top: 1rpx solid var(--text-10);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-70);
}

/* ===== 登录弹窗 ===== */
.login-dialog {
  max-width: 560rpx;
  padding: 32rpx 0 0;
}

.login-dialog .dialog-body {
  padding: 24rpx 36rpx 32rpx;
}

.login-dialog .dialog-header {
  padding: 0 36rpx 16rpx;
}

.login-dialog-desc {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: var(--text-60);
  text-align: center;
}

.login-field {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.login-field-label {
  font-size: 26rpx;
  color: var(--text-60);
  flex-shrink: 0;
  width: 64rpx;
  text-align: left;
}

.login-field-input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: var(--text-08);
  color: var(--text-main);
  font-size: 26rpx;
}

.login-dialog-confirm-btn {
  width: 320rpx !important;
  height: 68rpx !important;
  line-height: 68rpx !important;
  text-align: center;
  border-radius: 12rpx !important;
  background: #C8A046 !important;
  color: #1A1714 !important;
  font-size: 28rpx !important;
  font-weight: 600;
  border: none !important;
  padding: 0 !important;
}

.login-dialog-confirm-btn::after {
  border: none !important;
}

.login-dialog-btn-wrap {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.login-toggle {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(200, 160, 70, 0.6);
}
