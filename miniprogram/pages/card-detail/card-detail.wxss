/* ===== 头像裁剪弹窗 ===== */
.crop-dialog-box {
  width: 85vw;
  background: #1A1714;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.crop-body {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  overflow: hidden;
}

.crop-canvas-area {
  position: relative;
  overflow: hidden;
  background: #000;
}

.crop-image {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
}

.crop-movable-area {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
}

.crop-movable-box {
  border: 2rpx solid #C8A046;
  box-sizing: border-box;
}

.crop-grid-line-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(200, 160, 70, 0.5);
}

.crop-grid-line-h1 {
  top: 33.33%;
}

.crop-grid-line-h2 {
  top: 66.66%;
}

.crop-grid-line-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(200, 160, 70, 0.5);
}

.crop-grid-line-v1 {
  left: 33.33%;
}

.crop-grid-line-v2 {
  left: 66.66%;
}

.crop-actions {
  padding: 0 28rpx 24rpx;
}

.crop-resize-handle {
  position: absolute;
  width: 32px;
  height: 32px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.crop-resize-icon {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 3px solid #C8A046;
  background: rgba(26, 23, 20, 0.8);
}

.crop-canvas-hidden {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 300px;
  height: 300px;
}