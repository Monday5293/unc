.detail-page {
  min-height: 100vh;
  background-color: #1A1714;
}

.detail-header {
  position: relative;
  overflow: hidden;
  padding: 48rpx 40rpx;
}

/* 右上角 st 按钮 */
.st-btn {
  position: absolute;
  right: 40rpx;
  top: 48rpx;
  z-index: 10;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1px solid;
  font-size: 20rpx;
  font-weight: 700;
  font-family: monospace;
  letter-spacing: 1rpx;
}

.header-decoration {
  position: absolute;
  right: -16rpx;
  top: -8rpx;
  font-size: 200rpx;
  line-height: 1;
  opacity: 0.05;
}

.header-content {
  position: relative;
}

.system-badge-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.system-badge {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.custom-tag {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
}

.card-main {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
}

.card-avatar {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 24rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 80rpx;
}

.card-info {
  min-width: 0;
  flex: 1;
  padding-top: 8rpx;
}

.card-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #E8DCC4;
}

.card-player {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
}

.card-desc {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid;
  background-color: rgba(26, 23, 20, 0.4);
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(232, 220, 196, 0.7);
}

.preview-stats {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: stretch;
}

.stat-wrapper {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-item {
  width: 100%;
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background-color: rgba(26, 23, 20, 0.6);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.5);
}

.detail-content {
  padding: 0 32rpx 64rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.title-line {
  flex: 1;
  height: 1rpx;
  background-color: rgba(232, 220, 196, 0.1);
}

/* ============================================ */
/* 手动属性表通用样式 */
/* ============================================ */
.sheet-block {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.sheet-card {
  padding: 24rpx;
  border-radius: 16rpx;
}

.sheet-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-card-header .sheet-card-title {
  margin-bottom: 0;
}

.sheet-card-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-card-sub {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.2);
}

.section-icon {
  font-size: 20rpx;
  opacity: 0.3;
  margin-right: 8rpx;
}

/* ===== 基本信息网格 ===== */
.info-grid-2 {
  display: flex;
  flex-wrap: wrap;
}

.info-row {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.info-row:nth-child(odd) {
  padding-right: 16rpx;
}

.info-row:nth-child(even) {
  padding-left: 16rpx;
}

.info-row-full {
  width: 100%;
  padding-right: 0;
  padding-left: 0;
}

.info-label {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.info-value {
  font-size: 22rpx;
  color: #E8DCC4;
  text-align: right;
}

/* ===== COC 3列属性 ===== */
.attr-grid-3 {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.attr-cell-3 {
  width: 32%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* ===== COC 4列状态 ===== */
.stat-row-4 {
  display: flex;
  gap: 16rpx;
}

.stat-row-4 .stat-card {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
}

.stat-row-4 .stat-card-val {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-row-4 .stat-card-max {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.2);
}

.stat-row-4 .stat-card-abbr {
  display: block;
  font-size: 16rpx;
  color: rgba(232, 220, 196, 0.3);
  margin-top: 2rpx;
}

.stat-card-btns {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

/* 快速调整栏 */
.stat-adjust-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.stat-adjust-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
  border: 1px solid;
}

.stat-adjust-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(232, 220, 196, 0.7);
  background: rgba(232, 220, 196, 0.06);
  border: 1px solid rgba(232, 220, 196, 0.12);
}

.stat-adjust-btn:active {
  background: rgba(232, 220, 196, 0.18);
  color: rgba(232, 220, 196, 0.95);
}

.hp-color { color: #ef4444; }
.mp-color { color: #818cf8; }
.san-color { color: #a78bfa; }
.ac-color { color: #22c55e; }

/* ===== 技能表 2列布局 ===== */
.skill-two-col {
  display: flex;
  gap: 16rpx;
}

.skill-col {
  flex: 1;
  min-width: 0;
}

/* ===== 技能表头 ===== */
.skill-header-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.skill-edit-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.skill-edit-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.skill-toggle-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.skill-toggle-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.skill-table-header {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
}

.skill-th-name {
  width: 66rpx;
  flex-shrink: 0;
}

.skill-th-num {
  flex: 1;
  text-align: center;
}

.skill-th-pct {
  flex: 1;
  text-align: center;
}

.skill-table-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  font-size: 20rpx;
}

.skill-td-name {
  width: 66rpx;
  flex-shrink: 0;
  min-width: 0;
}

.skill-td-zh {
  color: rgba(232, 220, 196, 0.7);
  word-break: keep-all;
  overflow-wrap: break-word;
  line-height: 1.15;
  display: inline-block;
  width: 66rpx;
  white-space: pre-line;
}

.skill-td-header {
  color: rgba(232, 220, 196, 0.5);
  font-weight: bold;
  font-size: 18rpx;
  width: auto;
}

.skill-td-en {
  margin-left: 6rpx;
  font-size: 16rpx;
  color: rgba(232, 220, 196, 0.18);
}

.skill-td-num {
  flex: 1;
  text-align: center;
  color: rgba(232, 220, 196, 0.3);
}

.skill-td-pct {
  flex: 1;
  text-align: center;
  font-weight: 700;
}

/* st 指令输入框 */
.st-textarea {
  height: 200rpx !important;
  font-size: 22rpx;
  font-family: monospace;
  line-height: 1.5;
}

.attr-grid-4 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.attr-cell {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
  box-sizing: border-box;
}

.attr-abbr {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
}

.attr-value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 4rpx;
}

.attr-label {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-top: 2rpx;
}

.attr-bar-bg {
  width: 100%;
  height: 4rpx;
  border-radius: 100rpx;
  background-color: rgba(232, 220, 196, 0.08);
  margin-top: 8rpx;
  overflow: hidden;
}

.attr-bar {
  height: 100%;
  border-radius: 100rpx;
}

/* ===== COC HP/MP/SAN 三列卡片 ===== */
.stat-row-3 {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
}

.stat-card-label {
  display: block;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.3);
}

.stat-card-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.stat-card-max {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.2);
}

.stat-card-abbr {
  display: block;
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.2);
  margin-top: 4rpx;
}

.hp-color { color: #ef4444; }
.mp-color { color: #818cf8; }
.san-color { color: #a78bfa; }

/* ===== 技能行 ===== */
.skill-row {
  margin-bottom: 16rpx;
}

.skill-row:last-child {
  margin-bottom: 0;
}

.skill-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.skill-label {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.5);
}

.skill-pct {
  font-size: 20rpx;
  font-weight: 700;
}

.skill-bar-bg {
  height: 12rpx;
  border-radius: 100rpx;
  background-color: rgba(232, 220, 196, 0.08);
  overflow: hidden;
}

.skill-bar {
  height: 100%;
  border-radius: 100rpx;
}

/* ===== DND 身份卡 ===== */
.dnd-id-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.dnd-id-icon {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 70rpx;
}

.dnd-id-info {
  min-width: 0;
  flex: 1;
}

.dnd-id-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #E8DCC4;
}

.dnd-id-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.dnd-level-tag {
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.dnd-id-race {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
}

.dnd-id-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.3);
}

.dot-sep {
  color: rgba(232, 220, 196, 0.15);
}

/* ===== DND 6项属性 ===== */
.dnd-attr-grid {
  display: flex;
  gap: 12rpx;
}

.dnd-attr-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
}

.dnd-attr-mod {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.dnd-attr-val {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(232, 220, 196, 0.6);
  margin-top: 4rpx;
}

.dnd-attr-abbr {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
  margin-top: 4rpx;
}

/* ===== DND 属性 v2（2行3列，3个数字） ===== */
.dnd-attr-grid-v2 {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dnd-attr-cell-v2 {
  width: calc(33.33% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
  box-sizing: border-box;
}

.dnd-attr-label-v2 {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 8rpx;
}

.dnd-attr-values-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.dnd-attr-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.dnd-attr-col-center {
  flex: 1.2;
}

.dnd-attr-sub-label {
  font-size: 14rpx;
  color: rgba(232, 220, 196, 0.25);
  margin-bottom: 2rpx;
}

.dnd-attr-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #E8DCC4;
  line-height: 1;
}

.dnd-attr-mod-v2 {
  font-size: 26rpx;
  font-weight: 700;
}

.dnd-attr-save {
  font-size: 24rpx;
  font-weight: 600;
}

.dnd-attr-abbr-v2 {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
  margin-top: 6rpx;
}

/* ===== DND 编辑表单 ===== */
.dnd-edit-form {
  padding: 8rpx 0;
}

.dnd-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dnd-edit-label {
  width: 100rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
  flex-shrink: 0;
}

.dnd-edit-input {
  flex: 1;
  font-size: 24rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(232, 220, 196, 0.1);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  min-height: 40rpx;
}

.dnd-edit-attr-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dnd-edit-attr-label {
  width: 80rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
  flex-shrink: 0;
}

.dnd-edit-attr-inputs {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.dnd-edit-input-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dnd-edit-input-label {
  flex: 1;
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.3);
  text-align: center;
}

.dnd-edit-header-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dnd-edit-attr-input {
  width: 100%;
  font-size: 24rpx;
  line-height: 48rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(232, 220, 196, 0.1);
  border-radius: 8rpx;
  padding: 0 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.dnd-edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dnd-edit-cancel {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.4);
  border: 1px solid rgba(232, 220, 196, 0.15);
  border-radius: 8rpx;
}

.dnd-edit-save {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: #1A1714;
  border-radius: 8rpx;
  font-weight: 600;
}

/* DND 环位 */
.spell-slots-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid rgba(232, 220, 196, 0.08);
}

.spell-slots-title {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 16rpx;
  display: block;
}

.spell-slots-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.spell-slot-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 6rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8rpx;
}

.spell-slot-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 6rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8rpx;
}

.spell-slot-label {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.3);
  margin-bottom: 6rpx;
}

.spell-slot-val {
  font-size: 22rpx;
  color: #E8DCC4;
  font-weight: 600;
}

.spell-slot-inputs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.spell-slot-sep {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.3);
  line-height: 40rpx;
}

.spell-slot-input {
  width: 56rpx;
  font-size: 20rpx;
  line-height: 40rpx;
  height: 40rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(232, 220, 196, 0.1);
  border-radius: 6rpx;
  text-align: center;
  padding: 0;
  box-sizing: border-box;
  vertical-align: middle;
}

/* ===== 标签区域 ===== */
.tag-section {
  margin-bottom: 16rpx;
}

.tag-section:last-child {
  margin-bottom: 0;
}

.tag-section-label {
  display: block;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.25);
  margin-bottom: 12rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag-item {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

/* ===== Daggerheart 3列属性 ===== */
.dh-attr-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dh-attr-cell {
  width: calc(33.33% - 11rpx);
  padding: 16rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  box-sizing: border-box;
}

.dh-attr-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dh-attr-label {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
}

.dh-attr-abbr {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.15);
}

.dh-attr-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

/* ===== 故事文本 ===== */
.story-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(232, 220, 196, 0.55);
}

/* ===== 背景故事新模块 ===== */
.backstory-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-top: 12rpx;
}

.backstory-entry {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  border: 1px solid;
  transition: background 0.15s;
  position: relative;
}

.backstory-entry:active {
  background: rgba(232, 220, 196, 0.04);
}

.backstory-entry-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(232, 220, 196, 0.7);
}

.backstory-entry-preview {
  flex: 1;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.35);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.backstory-detail-section {
  margin-top: 20rpx;
}

.backstory-detail-label {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.6);
  margin-bottom: 10rpx;
  display: block;
}

.backstory-detail-preview {
  height: 480rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1px solid;
  overflow-y: auto;
}

.backstory-preview-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(232, 220, 196, 0.7);
  white-space: pre-wrap;
  word-break: break-all;
}

.backstory-preview-placeholder {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

/* 新增条目按钮 */
.add-entry-btn {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 8rpx;
  border: 1px dashed;
  text-align: center;
  font-size: 22rpx;
}

.add-entry-btn:active {
  background: rgba(232, 220, 196, 0.04);
}

/* 经历条目删除按钮 */
.exp-delete-btn {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.exp-delete-btn:active {
  opacity: 0.7;
}

/* 经历列标题 */
.experience-header {
  display: flex;
  align-items: center;
  padding: 0 16rpx 8rpx 16rpx;
  margin-bottom: 4rpx;
  border-bottom: 1px solid rgba(232, 220, 196, 0.06);
}

.experience-header-label {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.6);
}

.experience-header-label:first-child {
  width: 140rpx;
  flex-shrink: 0;
}

.experience-header-label:last-child {
  flex: 1;
  margin-left: 25rpx;
}

/* 经历条目内竖线分隔 */
.experience-entry-divider {
  width: 1px;
  height: 24rpx;
  background: rgba(232, 220, 196, 0.1);
  margin: 0 12rpx;
  flex-shrink: 0;
}

/* 经历条目：左右列与表头对齐 */
.experience-entry-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(232, 220, 196, 0.7);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.experience-entry-label.empty {
  color: rgba(232, 220, 196, 0.25);
}

.experience-entry-value {
  flex: 1;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.35);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-left: 0;
}

/* 经历弹窗编辑表单 */
.exp-edit-field {
  margin-bottom: 16rpx;
}

.exp-edit-label {
  display: block;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 8rpx;
}

.exp-edit-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: rgba(232, 220, 196, 0.85);
  background: rgba(232, 220, 196, 0.04);
  border: 1px solid rgba(232, 220, 196, 0.1);
  box-sizing: border-box;
}

.exp-detail-label {
  display: block;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 8rpx;
}

/* 背景故事弹窗 */
.backstory-dialog {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.backstory-dialog .dialog-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.backstory-edit-icon {
  font-size: 28rpx;
  color: #22c55e;
  padding: 4rpx 8rpx;
}

.backstory-dialog-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(232, 220, 196, 0.7);
  white-space: pre-wrap;
  word-break: break-all;
}

.backstory-textarea {
  min-height: 400rpx !important;
  font-size: 24rpx;
  line-height: 1.6;
}

.dialog-header-actions {
  display: flex;
  gap: 16rpx;
  margin-right: 16rpx;
}

.dialog-action-btn {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: rgba(232, 220, 196, 0.6);
  border: 1px solid rgba(232, 220, 196, 0.15);
  background: rgba(232, 220, 196, 0.06);
}

.dialog-action-btn.primary {
  color: #C8A046;
  border-color: rgba(200, 160, 70, 0.3);
  background: rgba(200, 160, 70, 0.1);
  font-weight: 600;
}

/* ===== 空状态 ===== */
.form-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(232, 220, 196, 0.5);
  margin-bottom: 8rpx;
}

.empty-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.3);
}

/* ===== 元信息 ===== */
.meta-info {
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
}

.meta-label {
  color: rgba(232, 220, 196, 0.4);
}

.meta-value {
  color: rgba(232, 220, 196, 0.5);
}

.action-buttons {
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.secondary {
  background-color: rgba(200, 160, 70, 0.1);
  border: 1rpx solid rgba(200, 160, 70, 0.3);
  color: #C8A046;
}

.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
  min-height: 100vh;
  background-color: #1A1714;
  box-sizing: border-box;
}

.not-found-icon {
  font-size: 80rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.not-found-text {
  font-size: 28rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 24rpx;
}

.not-found-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #C8A046;
  font-size: 24rpx;
  color: #C8A046;
}

/* ===== 编辑相关样式 ===== */

/* 技能编辑输入框 */
.skill-td-input {
  flex: 1;
  text-align: center;
  height: 40rpx;
  font-size: 20rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 4rpx;
  padding: 0 4rpx;
  min-width: 0;
}

/* 区域编辑按钮 */
.section-edit-btns {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-edit-btn {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  border: 1rpx solid;
  opacity: 0.7;
}

.section-edit-btn.primary {
  font-weight: 600;
  opacity: 1;
}

/* 基本信息编辑输入 */
.info-input {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: #E8DCC4;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 4rpx;
  padding: 0 8rpx;
  min-width: 0;
}

/* 属性编辑 */
.attr-edit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.attr-edit-cell {
  width: 32%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  box-sizing: border-box;
}

.attr-edit-label {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 4rpx;
}

.attr-edit-input {
  width: 80%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #E8DCC4;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6rpx;
  padding: 0 4rpx;
}

/* 状态编辑输入 */
.stat-edit-input {
  width: 70%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  height: 48rpx;
  line-height: 48rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6rpx;
  padding: 0 4rpx;
  margin: 0 auto 4rpx;
  color: #E8DCC4;
}

.stat-edit-sep {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.2);
}

.stat-edit-hp-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.stat-edit-hp-input {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  height: 48rpx;
  line-height: 48rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6rpx;
  padding: 0;
  color: #E8DCC4;
}

/* ===== 弹窗通用样式 ===== */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.dialog-box {
  width: 85vw;
  max-height: 80vh;
  background: #1A1714;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid rgba(232, 220, 196, 0.08);
}

.dialog-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C8A046;
}

.dialog-subtitle {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.35);
  margin-left: 16rpx;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dialog-close {
  font-size: 32rpx;
  color: rgba(232, 220, 196, 0.4);
  padding: 0 8rpx;
}

.dialog-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 28rpx;
}

.dialog-tip {
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
  border: 1rpx solid rgba(232, 220, 196, 0.15);
  background: rgba(232, 220, 196, 0.06);
}

.btn-primary {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1714;
  background: #C8A046;
}

.form-item {
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(232, 220, 196, 0.1);
  box-sizing: border-box;
}

.input-placeholder {
  color: rgba(232, 220, 196, 0.2);
}