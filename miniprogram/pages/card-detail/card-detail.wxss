page {
  background-color: #1A1714;
}

.detail-page {
  min-height: 100vh;
  background-color: #1A1714;
}

.detail-header {
  position: relative;
  overflow: hidden;
  padding: 48rpx 40rpx;
}

/* 右上角 st 按钮 */
.st-btn {
  position: absolute;
  right: 40rpx;
  top: 48rpx;
  z-index: 10;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1px solid;
  font-size: 20rpx;
  font-weight: 700;
  font-family: monospace;
  letter-spacing: 1rpx;
}

.header-decoration {
  position: absolute;
  right: -16rpx;
  top: -8rpx;
  font-size: 200rpx;
  line-height: 1;
  opacity: 0.05;
}

.header-content {
  position: relative;
}

.system-badge-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.system-badge {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.custom-tag {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
}

.card-main {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
}

.card-avatar {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 24rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 80rpx;
}

.card-info {
  min-width: 0;
  flex: 1;
  padding-top: 8rpx;
}

.card-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #E8DCC4;
}

.card-player {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
}

.card-desc {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid;
  background-color: rgba(26, 23, 20, 0.4);
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(232, 220, 196, 0.7);
}

.preview-stats {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: stretch;
}

.stat-wrapper {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-item {
  width: 100%;
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background-color: rgba(26, 23, 20, 0.6);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-value-small {
  font-size: 22rpx;
  line-height: 1.3;
}

.stat-label {
  display: block;
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.5);
}

.detail-content {
  padding: 0 32rpx 64rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.title-line {
  flex: 1;
  height: 1rpx;
  background-color: rgba(232, 220, 196, 0.1);
}

/* ============================================ */
/* 手动属性表通用样式 */
/* ============================================ */
.sheet-block {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.sheet-card {
  padding: 24rpx;
  border-radius: 16rpx;
}

.sheet-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-card-header .sheet-card-title {
  margin-bottom: 0;
}

.sheet-card-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sheet-card-sub {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.2);
}

.section-icon {
  font-size: 20rpx;
  opacity: 0.3;
  margin-right: 8rpx;
}

/* ===== 基本信息网格 ===== */
.info-grid-2 {
  display: flex;
  flex-wrap: wrap;
}

.info-row {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.info-row:nth-child(odd) {
  padding-right: 16rpx;
}

.info-row:nth-child(even) {
  padding-left: 16rpx;
}

.info-row-full {
  width: 100%;
  padding-right: 0;
  padding-left: 0;
}

.info-label {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.info-value {
  font-size: 22rpx;
  color: #E8DCC4;
  text-align: right;
}

/* ===== COC 3列属性 ===== */
.attr-grid-3 {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.attr-cell-3 {
  width: 32%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* ===== COC 4列状态 ===== */
.stat-row-4 {
  display: flex;
  gap: 16rpx;
}

.stat-row-4 .stat-card {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
}

.stat-row-4 .stat-card-val {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-row-4 .stat-card-max {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.2);
}

.stat-row-4 .stat-card-abbr {
  display: block;
  font-size: 16rpx;
  color: rgba(232, 220, 196, 0.3);
  margin-top: 2rpx;
}

.stat-card-btns {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

/* 快速调整栏 */
.stat-adjust-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.stat-adjust-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
  border: 1px solid;
}

.stat-adjust-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(232, 220, 196, 0.7);
  background: rgba(232, 220, 196, 0.06);
  border: 1px solid rgba(232, 220, 196, 0.12);
}

.stat-adjust-btn:active {
  background: rgba(232, 220, 196, 0.18);
  color: rgba(232, 220, 196, 0.95);
}

.hp-color { color: #ef4444; }
.mp-color { color: #818cf8; }
.san-color { color: #a78bfa; }
.ac-color { color: #22c55e; }

/* ===== 技能表 2列布局 ===== */
.skill-two-col {
  display: flex;
  gap: 16rpx;
}

.skill-col {
  flex: 1;
  min-width: 0;
}

/* ===== 技能表头 ===== */
.skill-header-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.skill-edit-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.skill-edit-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.skill-toggle-btn {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.skill-toggle-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.skill-table-header {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
}

.skill-th-name {
  width: 66rpx;
  flex-shrink: 0;
}

.skill-th-num {
  flex: 1;
  text-align: center;
}

.skill-th-pct {
  flex: 1;
  text-align: center;
}

.skill-table-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  font-size: 20rpx;
}

.skill-td-name {
  width: 66rpx;
  flex-shrink: 0;
  min-width: 0;
}

.skill-td-zh {
  color: rgba(232, 220, 196, 0.7);
  word-break: keep-all;
  overflow-wrap: break-word;
  line-height: 1.15;
  display: inline-block;
  width: 66rpx;
  white-space: pre-line;
}

.skill-td-header {
  color: rgba(232, 220, 196, 0.5);
  font-weight: bold;
  font-size: 18rpx;
  width: auto;
}

.skill-td-en {
  margin-left: 6rpx;
  font-size: 16rpx;
  color: rgba(232, 220, 196, 0.18);
}

.skill-td-num {
  flex: 1;
  text-align: center;
  color: rgba(232, 220, 196, 0.3);
}

.skill-td-pct {
  flex: 1;
  text-align: center;
  font-weight: 700;
}

/* st 指令输入框 */
.st-textarea {
  height: 200rpx !important;
  font-size: 22rpx;
  font-family: monospace;
  line-height: 1.5;
}

.attr-grid-4 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.attr-cell {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
  box-sizing: border-box;
}

.attr-abbr {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
}

.attr-value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 4rpx;
}

.attr-label {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-top: 2rpx;
}

.attr-bar-bg {
  width: 100%;
  height: 4rpx;
  border-radius: 100rpx;
  background-color: rgba(232, 220, 196, 0.08);
  margin-top: 8rpx;
  overflow: hidden;
}

.attr-bar {
  height: 100%;
  border-radius: 100rpx;
}

/* ===== COC HP/MP/SAN 三列卡片 ===== */
.stat-row-3 {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
}

.stat-card-label {
  display: block;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.3);
}

.stat-card-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.stat-card-max {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.2);
}

.stat-card-abbr {
  display: block;
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.2);
  margin-top: 4rpx;
}

.hp-color { color: #ef4444; }
.mp-color { color: #818cf8; }
.san-color { color: #a78bfa; }

/* ===== 技能行 ===== */
.skill-row {
  margin-bottom: 16rpx;
}

.skill-row:last-child {
  margin-bottom: 0;
}

.skill-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.skill-label {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.5);
}

.skill-pct {
  font-size: 20rpx;
  font-weight: 700;
}

.skill-bar-bg {
  height: 12rpx;
  border-radius: 100rpx;
  background-color: rgba(232, 220, 196, 0.08);
  overflow: hidden;
}

.skill-bar {
  height: 100%;
  border-radius: 100rpx;
}

/* ===== DND 身份卡 ===== */
.dnd-id-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.dnd-id-icon {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 70rpx;
}

.dnd-id-info {
  min-width: 0;
  flex: 1;
}

.dnd-id-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #E8DCC4;
}

.dnd-id-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.dnd-level-tag {
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.dnd-id-race {
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
}

.dnd-id-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.3);
}

.dot-sep {
  color: rgba(232, 220, 196, 0.15);
}

/* ===== DND 6项属性 ===== */
.dnd-attr-grid {
  display: flex;
  gap: 12rpx;
}

.dnd-attr-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
}

.dnd-attr-mod {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.dnd-attr-val {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(232, 220, 196, 0.6);
  margin-top: 4rpx;
}

.dnd-attr-abbr {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
  margin-top: 4rpx;
}

/* ===== DND 属性 v2（2行3列，3个数字） ===== */
.dnd-attr-grid-v2 {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dnd-attr-cell-v2 {
  width: calc(33.33% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.03);
  text-align: center;
  box-sizing: border-box;
}

.dnd-attr-label-v2 {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 8rpx;
}

.dnd-attr-values-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.dnd-attr-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.dnd-attr-col-center {
  flex: 1.2;
}

.dnd-attr-sub-label {
  font-size: 14rpx;
  color: rgba(232, 220, 196, 0.25);
  margin-bottom: 2rpx;
}

.dnd-attr-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #E8DCC4;
  line-height: 1;
}

.dnd-attr-mod-v2 {
  font-size: 26rpx;
  font-weight: 700;
}

.dnd-attr-save {
  font-size: 24rpx;
  font-weight: 600;
}

.dnd-attr-abbr-v2 {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 220, 196, 0.2);
  margin-top: 6rpx;
}

/* ===== DND 编辑表单 ===== */
.dnd-edit-form {
  padding: 8rpx 0;
}

.dnd-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dnd-edit-label {
  width: 100rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
  flex-shrink: 0;
}

.dnd-edit-input {
  flex: 1;
  font-size: 24rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(232, 220, 196, 0.1);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  min-height: 40rpx;
}

.dnd-edit-attr-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dnd-edit-attr-label {
  width: 80rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.5);
  flex-shrink: 0;
}

.dnd-edit-attr-inputs {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.dnd-edit-input-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dnd-edit-input-label {
  flex: 1;
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.3);
  text-align: center;
}

.dnd-edit-header-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dnd-edit-attr-input {
  width: 100%;
  font-size: 24rpx;
  line-height: 48rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(232, 220, 196, 0.1);
  border-radius: 8rpx;
  padding: 0 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.dnd-edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dnd-edit-cancel {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: rgba(232, 220, 196, 0.4);
  border: 1px solid rgba(232, 220, 196, 0.15);
  border-radius: 8rpx;
}

.dnd-edit-save {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: #1A1714;
  border-radius: 8rpx;
  font-weight: 600;
}

/* DND 环位 */
.spell-slots-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid rgba(232, 220, 196, 0.08);
}

.spell-slots-title {
  font-size: 22rpx;
  color: rgba(232, 220, 196, 0.4);
  margin-bottom: 16rpx;
  display: block;
}

.spell-slots-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.spell-slot-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 6rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8rpx;
}

.spell-slot-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 6rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8rpx;
}

.spell-slot-label {
  font-size: 18rpx;
  color: rgba(232, 220, 196, 0.3);
  margin-bottom: 6rpx;
}

.spell-slot-val {
  font-size: 28rpx;
  color: #E8DCC4;
  font-weight: 600;
  flex: 1;
  text-align: center;
}

.spell-slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0 20rpx;
}

.spell-slot-inputs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.spell-slot-sep {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.3);
  line-height: 40rpx;
}

.spell-slot-btn {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(232, 220, 196, 0.15);
  border-radius: 6rpx;
  flex-shrink: 0;
}

.spell-slot-input {
  width: 56rpx;
  font-size: 20rpx;
  line-height: 40rpx;
  height: 40rpx;
  color: #E8DCC4;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(232, 220, 196, 0.1);
  border-radius: 6rpx;
  text-align: center;
  padding: 0;
  box-sizing: border-box;
  vertical-align: middle;
}

/* ===== DND 技能网格 ===== */
.dnd-skills-grid {
  display: flex;
  gap: 6rpx;
}

.dnd-skills-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dnd-skill-cell {
  display: flex;
  align-items: center;
  padding: 10rpx 12rpx;
  background: rgba(255, 255, 255, 0.03);
  border-left: 4rpx solid transparent;
  border-bottom: 1rpx solid rgba(232, 220, 196, 0.05);
}

.dnd-skill-cell:last-child {
  border-bottom: none;
}

.dnd-skill-first {
  border-top-left-radius: 6rpx;
  border-top-right-radius: 6rpx;
}

.dnd-skill-last {
  border-bottom-left-radius: 6rpx;
