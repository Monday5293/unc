          <text class="section-edit-btn" catchtap="startDhFeatureEdit" style="color: {{accentColor}};">✎</text>
        </block>
      </view>
    </view>
    <view class="dialog-body">
      <view wx:if="{{dhFeatureDialogEditing}}" class="weapon-edit-form">
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">名称</text>
          <input class="weapon-edit-input" value="{{dhFeatureDialogName}}" bindinput="onDhFeatureDialogInput" data-field="name" />
        </view>
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">描述</text>
          <textarea class="form-textarea backstory-textarea" placeholder="特性描述" placeholder-class="input-placeholder" maxlength="-1" value="{{dhFeatureDialogDesc}}" bindinput="onDhFeatureDialogInput" data-field="desc" />
        </view>
      </view>
      <view wx:else class="weapon-detail-view">
        <view class="weapon-detail-row"><text class="weapon-detail-label">名称</text><text class="weapon-detail-value">{{dhFeatureDialogName || '暂无'}}</text></view>
        <view class="weapon-detail-row"><text class="weapon-detail-label">描述</text><text class="weapon-detail-value">{{dhFeatureDialogDesc || '暂无'}}</text></view>
      </view>
    </view>
  </view>
</view>

<!-- 领域卡弹窗 -->
<view wx:if="{{dhDomainDialogVisible}}" class="dialog-mask {{theme === 'light' ? 'theme-light' : ''}}" bindtap="closeDhDomainDialog">
  <view class="dialog-box" catchtap="stopPropagation">
    <view class="dialog-header">
      <text class="dialog-title" style="color: {{accentColor}};">领域卡详情</text>
      <view class="weapon-dialog-btns">
        <block wx:if="{{dhDomainDialogEditing}}">
          <text class="section-edit-btn" catchtap="cancelDhDomainEdit" style="color: {{accentColor}};">取消</text>
          <text class="section-edit-btn primary" catchtap="applyDhDomainEdit" style="color: {{accentColor}};">保存</text>
        </block>
        <block wx:else>
          <text class="section-edit-btn delete-btn" catchtap="onDeleteDhDomainFromDialog" style="color: #ef4444;">删除</text>
          <text class="section-edit-btn" catchtap="startDhDomainEdit" style="color: {{accentColor}};">✎</text>
        </block>
      </view>
    </view>
    <view class="dialog-body">
      <view wx:if="{{dhDomainDialogEditing}}" class="weapon-edit-form">
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">名称</text>
          <input class="weapon-edit-input" value="{{dhDomainDialogName}}" bindinput="onDhDomainDialogInput" data-field="name" />
        </view>
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">领域</text>
          <input class="weapon-edit-input" value="{{dhDomainDialogDomain}}" bindinput="onDhDomainDialogInput" data-field="domain" />
        </view>
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">属性</text>
          <input class="weapon-edit-input" value="{{dhDomainDialogAbility}}" bindinput="onDhDomainDialogInput" data-field="ability" />
        </view>
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">RC</text>
          <input class="weapon-edit-input" type="number" value="{{dhDomainDialogRC}}" bindinput="onDhDomainDialogInput" data-field="RC" />
        </view>
        <view class="weapon-edit-row">
          <text class="weapon-edit-label">描述</text>
          <textarea class="form-textarea backstory-textarea" placeholder="领域卡描述" placeholder-class="input-placeholder" maxlength="-1" value="{{dhDomainDialogDesc}}" bindinput="onDhDomainDialogInput" data-field="desc" />
        </view>
      </view>
      <view wx:else class="weapon-detail-view">
        <view class="weapon-detail-row"><text class="weapon-detail-label">名称</text><text class="weapon-detail-value">{{dhDomainDialogName || '暂无'}}</text></view>
        <view class="weapon-detail-row"><text class="weapon-detail-label">领域</text><text class="weapon-detail-value">{{dhDomainDialogDomain || '暂无'}}</text></view>
        <view class="weapon-detail-row"><text class="weapon-detail-label">属性</text><text class="weapon-detail-value">{{dhDomainDialogAbility || '暂无'}}</text></view>
        <view class="weapon-detail-row"><text class="weapon-detail-label">RC</text><text class="weapon-detail-value">{{dhDomainDialogRC}}</text></view>
        <view class="weapon-detail-row"><text class="weapon-detail-label">描述</text><text class="weapon-detail-value">{{dhDomainDialogDesc || '暂无'}}</text></view>
      </view>
    </view>
  </view>
</view>

<!-- 未登录提示弹窗 -->
<view wx:if="{{loginDialogVisible}}" class="dialog-mask {{theme === 'light' ? 'theme-light' : ''}}">
  <view class="dialog-box login-dialog" catchtap="stopPropagation">
    <view class="dialog-header">
      <text class="dialog-title">{{isRegisterMode ? '注册' : '登录'}}</text>
      <text class="dialog-close" bindtap="cancelLoginDialog">✕</text>
    </view>
    <view class="dialog-body">
      <text class="dialog-desc login-dialog-desc">登录后才能修改角色卡</text>
      <view class="login-field">
        <text class="login-field-label">昵称</text>
        <input class="login-field-input" type="nickname" value="{{loginName}}" bindinput="onLoginNameInput" bindblur="onLoginNameBlur" placeholder="请输入昵称" />
      </view>
      <view class="login-field">
          <text class="login-field-label">密码</text>
          <input class="login-field-input" type="password" value="{{loginPassword}}" bindinput="onLoginPasswordInput" placeholder="请输入密码" />
        </view>
        <view class="login-field" wx:if="{{isRegisterMode}}">
          <text class="login-field-label">邀请码</text>
          <input class="login-field-input" value="{{loginInviteCode}}" bindinput="onLoginInviteInput" placeholder="请输入邀请码" />
        </view>
      <view class="login-dialog-btn-wrap">
        <button class="login-dialog-confirm-btn" bindtap="doLoginSubmit">{{isRegisterMode ? '注册' : '登录'}}</button>
      </view>
      <view class="login-toggle" bindtap="toggleLoginMode">
        <text>{{isRegisterMode ? '已有账号？去登录' : '没有账号？去注册'}}</text>
      </view>
    </view>
  </view>
</view>