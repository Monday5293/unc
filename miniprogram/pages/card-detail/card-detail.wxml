<view class="detail-page" wx:if="{{!cardNotFound && card}}">
  <view class="detail-header" style="background: linear-gradient(180deg, {{accentColor}}22 0%, transparent 100%);">
    <view class="header-decoration">{{systemInfo.logo}}</view>

    <!-- 右上角 st 指令按钮 -->
    <view class="st-btn" bindtap="openStDialog" style="border-color: {{accentColor}}55; color: {{accentColor}};">
      <text>.st</text>
    </view>

    <view class="header-content">
      <view class="system-badge-row">
        <view class="system-badge" style="color: {{accentColor}}; background-color: {{accentColor}}22;">
          {{systemInfo.logo}} {{systemInfo.fullName}}
        </view>
        <text wx:if="{{systemInfo.isCustom}}" class="custom-tag">· 自定义规则</text>
      </view>

      <view class="card-main">
        <view class="card-avatar" style="background-color: {{accentColor}}22; box-shadow: 0 0 0 2px {{accentColor}}55 inset;" bindtap="onChooseAvatar">
          <image wx:if="{{card.avatar}}" src="{{card.avatar}}" class="avatar-img" mode="aspectFill"></image>
          <text wx:else class="avatar-text">{{systemInfo.logo}}</text>
        </view>
        <view class="card-info">
          <text class="card-name">{{card.formData.name || card.name}}</text>
          <text class="card-player">玩家：{{card.formData.player || card.player}}</text>
        </view>
      </view>

      <view wx:if="{{card.description}}" class="card-desc" style="border-color: {{accentColor}};">
        {{card.description}}
      </view>

      <view wx:if="{{previewStats.length > 0}}" class="preview-stats">
        <view
          wx:for="{{previewStats}}"
          wx:key="label"
          class="stat-wrapper"
        >
          <text class="stat-label">{{item.label}}</text>
          <view class="stat-item" style="box-shadow: 0 0 0 1px {{accentColor}}33;">
            <text class="stat-value" style="color: {{accentColor}}">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="detail-content">
    <view class="section-header">
      <text class="section-title" style="color: {{accentColor}};">完整属性表</text>
      <view class="title-line"></view>
    </view>

    <!-- ============================================ -->
    <!-- COC 7e 调查员卡 手动属性表 -->
    <!-- ============================================ -->
    <view wx:if="{{system === 'COC'}}" class="sheet-block">
      <!-- 基本信息（4行2列） -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">基本信息</text>
          <view class="section-edit-btns">
            <block wx:if="{{editingBasicInfo}}">
              <text class="section-edit-btn" bindtap="cancelEditBasicInfo" style="color: {{accentColor}};">取消</text>
              <text class="section-edit-btn primary" bindtap="applyEditBasicInfo" style="color: {{accentColor}};">保存</text>
            </block>
            <text wx:else class="section-edit-btn" bindtap="startEditBasicInfo" style="color: {{accentColor}};">✎</text>
          </view>
        </view>
        <view wx:if="{{editingBasicInfo}}" class="info-grid-2">
          <view class="info-row"><text class="info-label">姓名</text><input class="info-input" value="{{editBasicInfo.name}}" data-field="name" bindinput="onEditBasicInput" /></view>
          <view class="info-row"><text class="info-label">职业</text><input class="info-input" value="{{editBasicInfo.occupation}}" data-field="occupation" bindinput="onEditBasicInput" /></view>
          <view class="info-row"><text class="info-label">玩家</text><input class="info-input" value="{{editBasicInfo.player}}" data-field="player" bindinput="onEditBasicInput" /></view>
          <view class="info-row"><text class="info-label">年龄</text><input class="info-input" value="{{editBasicInfo.age}}" data-field="age" bindinput="onEditBasicInput" /></view>
          <view class="info-row"><text class="info-label">性别</text><input class="info-input" value="{{editBasicInfo.gender}}" data-field="gender" bindinput="onEditBasicInput" /></view>
          <view class="info-row"><text class="info-label">年份</text><input class="info-input" value="{{editBasicInfo.year}}" data-field="year" bindinput="onEditBasicInput" /></view>
          <view class="info-row info-row-full"><text class="info-label">居住地</text><input class="info-input" value="{{editBasicInfo.residence}}" data-field="residence" bindinput="onEditBasicInput" /></view>
        </view>
        <view wx:else class="info-grid-2">
          <view class="info-row"><text class="info-label">姓名</text><text class="info-value">{{card.formData.name || card.name || '-'}}</text></view>
          <view class="info-row"><text class="info-label">职业</text><text class="info-value">{{card.formData.occupation || '-'}}</text></view>
          <view class="info-row"><text class="info-label">玩家</text><text class="info-value">{{card.formData.player || card.player || '-'}}</text></view>
          <view class="info-row"><text class="info-label">年龄</text><text class="info-value">{{card.formData.age || '-'}}</text></view>
          <view class="info-row"><text class="info-label">性别</text><text class="info-value">{{card.formData.gender || '-'}}</text></view>
          <view class="info-row"><text class="info-label">年份</text><text class="info-value">{{card.formData.year || '1920s'}}</text></view>
          <view class="info-row info-row-full"><text class="info-label">居住地</text><text class="info-value">{{card.formData.residence || '-'}}</text></view>
        </view>
      </view>

      <!-- 9 项属性（3x3网格） -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">基础属性</text>
          <view class="section-edit-btns">
            <block wx:if="{{editingAttrs}}">
              <text class="section-edit-btn" bindtap="cancelEditAttrs" style="color: {{accentColor}};">取消</text>
              <text class="section-edit-btn primary" bindtap="applyEditAttrs" style="color: {{accentColor}};">保存</text>
            </block>
            <text wx:else class="section-edit-btn" bindtap="startEditAttrs" style="color: {{accentColor}};">✎</text>
          </view>
        </view>
        <view wx:if="{{editingAttrs}}" class="attr-edit-grid">
          <view wx:for="{{attrEditList}}" wx:key="key" class="attr-edit-cell">
            <text class="attr-edit-label">{{item.label}}</text>
            <input class="attr-edit-input" type="number" value="{{editAttrs[item.key]}}" data-field="{{item.key}}" bindinput="onEditAttrInput" />
          </view>
        </view>
        <view wx:else class="attr-grid-3">
          <view wx:for="{{cocAttributes}}" wx:key="key" class="attr-cell-3">
            <text class="attr-abbr">{{item.abbr}}</text>
            <text class="attr-value" style="color: {{item.color}};">{{item.value}}</text>
            <text class="attr-label">{{item.label}}</text>
            <view class="attr-bar-bg"><view class="attr-bar" style="width: {{item.value < 99 ? item.value : 99}}%; background: {{item.color}}; opacity: 0.45;"></view></view>
          </view>
        </view>
      </view>

      <!-- 当前状态（1行4列） -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">当前状态</text>
          <view class="section-edit-btns">
            <block wx:if="{{editingStatus}}">
              <text class="section-edit-btn" bindtap="cancelEditStatus" style="color: {{accentColor}};">取消</text>
              <text class="section-edit-btn primary" bindtap="applyEditStatus" style="color: {{accentColor}};">保存</text>
            </block>
            <text wx:else class="section-edit-btn" bindtap="startEditStatus" style="color: {{accentColor}};">✎</text>
          </view>
        </view>
        <view wx:if="{{editingStatus}}" class="stat-row-4">
          <view class="stat-card" style="background: linear-gradient(180deg, #ef444414 0%, #ef444406 100%); box-shadow: 0 0 0 1px #ef444433;">
            <input class="stat-edit-input hp-color" type="number" value="{{editStatus.hp}}" data-field="hp" bindinput="onEditStatusInput" />
            <text class="stat-edit-sep">/</text>
            <input class="stat-edit-input" type="number" value="{{editStatus.hpMax}}" data-field="hpMax" bindinput="onEditStatusInput" />
            <text class="stat-card-abbr">体力 HP</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #8b5cf614 0%, #8b5cf606 100%); box-shadow: 0 0 0 1px #8b5cf633;">
            <input class="stat-edit-input san-color" type="number" value="{{editStatus.san}}" data-field="san" bindinput="onEditStatusInput" />
            <text class="stat-edit-sep">/</text>
            <input class="stat-edit-input" type="number" value="{{editStatus.sanMax}}" data-field="sanMax" bindinput="onEditStatusInput" />
            <text class="stat-card-abbr">理智 SAN</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #6366f114 0%, #6366f106 100%); box-shadow: 0 0 0 1px #6366f133;">
            <input class="stat-edit-input mp-color" type="number" value="{{editStatus.mp}}" data-field="mp" bindinput="onEditStatusInput" />
            <text class="stat-edit-sep">/</text>
            <input class="stat-edit-input" type="number" value="{{editStatus.mpMax}}" data-field="mpMax" bindinput="onEditStatusInput" />
            <text class="stat-card-abbr">魔法 MP</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #22c55e14 0%, #22c55e06 100%); box-shadow: 0 0 0 1px #22c55e33;">
            <input class="stat-edit-input ac-color" type="number" value="{{editStatus.ac}}" data-field="ac" bindinput="onEditStatusInput" />
            <text class="stat-card-abbr">护甲 AC</text>
          </view>
        </view>
        <view wx:else class="stat-row-4">
          <view class="stat-card" style="background: linear-gradient(180deg, #ef444414 0%, #ef444406 100%); box-shadow: 0 0 0 1px #ef444433;">
            <text class="stat-card-val hp-color">{{card.formData.hp || '-'}}<text class="stat-card-max">/{{card.formData.hpMax || '-'}}</text></text>
            <text class="stat-card-abbr">体力 HP</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #8b5cf614 0%, #8b5cf606 100%); box-shadow: 0 0 0 1px #8b5cf633;">
            <text class="stat-card-val san-color">{{card.formData.san || '-'}}</text>
            <text class="stat-card-abbr">理智 SAN</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #6366f114 0%, #6366f106 100%); box-shadow: 0 0 0 1px #6366f133;">
            <text class="stat-card-val mp-color">{{card.formData.mp || '-'}}</text>
            <text class="stat-card-abbr">魔法 MP</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #22c55e14 0%, #22c55e06 100%); box-shadow: 0 0 0 1px #22c55e33;">
            <text class="stat-card-val ac-color">{{card.formData.ac || 0}}</text>
            <text class="stat-card-abbr">护甲 AC</text>
          </view>
        </view>
        <!-- 快速调整框架 -->
        <view class="stat-adjust-bar">
          <view class="stat-adjust-item" style="border-color: #ef444444; background: #ef444408;">
            <text class="stat-adjust-btn" bindtap="onStatDecrement" data-field="hp">−</text>
            <text class="stat-adjust-btn" bindtap="onStatIncrement" data-field="hp">+</text>
          </view>
          <view class="stat-adjust-item" style="border-color: #a78bfa44; background: #a78bfa08;">
            <text class="stat-adjust-btn" bindtap="onStatDecrement" data-field="san">−</text>
            <text class="stat-adjust-btn" bindtap="onStatIncrement" data-field="san">+</text>
          </view>
          <view class="stat-adjust-item" style="border-color: #818cf844; background: #818cf808;">
            <text class="stat-adjust-btn" bindtap="onStatDecrement" data-field="mp">−</text>
            <text class="stat-adjust-btn" bindtap="onStatIncrement" data-field="mp">+</text>
          </view>
          <view class="stat-adjust-item" style="border-color: #22c55e44; background: #22c55e08;">
            <text class="stat-adjust-btn" bindtap="onStatDecrement" data-field="ac">−</text>
            <text class="stat-adjust-btn" bindtap="onStatIncrement" data-field="ac">+</text>
          </view>
        </view>
      </view>

      <!-- 技能表（2列布局，保留初始/职业/兴趣/成功率） -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">技能表</text>
          <view class="skill-header-actions">
            <view class="skill-edit-btn {{cocSkillMode === 'simple' ? 'disabled' : ''}}" bindtap="toggleSkillEdit" style="color: {{accentColor}}; background: {{accentColor}}15; border: 1px solid {{accentColor}}28;">
              <text wx:if="{{!cocSkillEditing}}">✎ 编辑</text>
              <text wx:else>✓ 完成</text>
            </view>
            <view class="skill-toggle-btn {{cocSkillEditing ? 'disabled' : ''}}" bindtap="toggleSkillMode" style="color: {{accentColor}}; background: {{accentColor}}15; border: 1px solid {{accentColor}}28;">
              <text wx:if="{{cocSkillMode === 'detailed'}}">☰ 简单模式</text>
              <text wx:else>☰ 详细模式</text>
            </view>
          </view>
        </view>

        <view class="skill-two-col">
          <!-- 左列 -->
          <view class="skill-col">
            <view class="skill-table-header" style="border-bottom: 1px solid {{accentColor}}15;">
              <text class="skill-th-name">技能</text>
              <text class="skill-th-num">成长</text>
              <text class="skill-th-num">职业</text>
              <text class="skill-th-num">兴趣</text>
              <text class="skill-th-pct">成功率</text>
            </view>
            <block wx:for="{{cocSkillLeft}}" wx:key="key">
              <view wx:if="{{item.isHeader}}" class="skill-table-row" style="border-bottom: 1px solid {{accentColor}}08;">
                <text class="skill-td-name skill-td-header">{{item.zh}}</text>
              </view>
              <view wx:elif="{{cocSkillMode === 'detailed' || item.changed}}" class="skill-table-row" style="border-bottom: 1px solid {{accentColor}}08;">
                <text class="skill-td-name skill-td-zh">{{item.displayName}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.growth || 0}}" data-col="left" data-idx="{{index}}" bindinput="onSkillGrowthInput" />
                <text wx:else class="skill-td-num" style="color: {{item.growth > 0 ? accentColor : 'rgba(232,220,196,0.2)'}};">{{item.growth || 0}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.occ || 0}}" data-col="left" data-idx="{{index}}" bindinput="onSkillOccInput" />
                <text wx:else class="skill-td-num" style="color: {{item.occ > 0 ? accentColor : 'rgba(232,220,196,0.2)'}};">{{item.occ || 0}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.int || 0}}" data-col="left" data-idx="{{index}}" bindinput="onSkillIntInput" />
                <text wx:else class="skill-td-num" style="color: {{item.int > 0 ? accentColor : 'rgba(232,220,196,0.2)'}};">{{item.int || 0}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.current}}" data-col="left" data-idx="{{index}}" bindinput="onSkillCurrentInput" />
                <text wx:else class="skill-td-pct" style="color: {{item.color}};">{{item.current}}%</text>
              </view>
            </block>
          </view>
          <!-- 右列 -->
          <view class="skill-col">
            <view class="skill-table-header" style="border-bottom: 1px solid {{accentColor}}15;">
              <text class="skill-th-name">技能</text>
              <text class="skill-th-num">成长</text>
              <text class="skill-th-num">职业</text>
              <text class="skill-th-num">兴趣</text>
              <text class="skill-th-pct">成功率</text>
            </view>
            <block wx:for="{{cocSkillRight}}" wx:key="key">
              <view wx:if="{{item.isHeader}}" class="skill-table-row" style="border-bottom: 1px solid {{accentColor}}08;">
                <text class="skill-td-name skill-td-header">{{item.zh}}</text>
              </view>
              <view wx:elif="{{cocSkillMode === 'detailed' || item.changed}}" class="skill-table-row" style="border-bottom: 1px solid {{accentColor}}08;">
                <text class="skill-td-name skill-td-zh">{{item.displayName}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.growth || 0}}" data-col="right" data-idx="{{index}}" bindinput="onSkillGrowthInput" />
                <text wx:else class="skill-td-num" style="color: {{item.growth > 0 ? accentColor : 'rgba(232,220,196,0.2)'}};">{{item.growth || 0}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.occ || 0}}" data-col="right" data-idx="{{index}}" bindinput="onSkillOccInput" />
                <text wx:else class="skill-td-num" style="color: {{item.occ > 0 ? accentColor : 'rgba(232,220,196,0.2)'}};">{{item.occ || 0}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.int || 0}}" data-col="right" data-idx="{{index}}" bindinput="onSkillIntInput" />
                <text wx:else class="skill-td-num" style="color: {{item.int > 0 ? accentColor : 'rgba(232,220,196,0.2)'}};">{{item.int || 0}}</text>
                <input wx:if="{{cocSkillEditing}}" class="skill-td-input" type="number" value="{{item.current}}" data-col="right" data-idx="{{index}}" bindinput="onSkillCurrentInput" />
                <text wx:else class="skill-td-pct" style="color: {{item.color}};">{{item.current}}%</text>
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 背景故事 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">背景故事</text>
        </view>
        <!-- 8栏条目列表 -->
        <view class="backstory-list">
          <view
            wx:for="{{backstoryItems}}"
            wx:key="key"
            class="backstory-entry"
            style="border-color: {{accentColor}}15;"
            bindtap="onBackstoryEntryTap"
            bindlongpress="onCopyBackstoryEntry"
            data-key="{{item.key}}"
            data-label="{{item.label}}"
          >
            <text class="backstory-entry-label">{{item.label}}</text>
            <text class="backstory-entry-preview">{{card.formData[item.key] || '暂无'}}</text>
          </view>
        </view>
        <!-- 详细故事 -->
        <view class="backstory-detail-section">
          <text class="backstory-detail-label">详细故事</text>
          <view class="backstory-detail-preview" bindtap="onBackstoryDetailPreview" bindlongpress="onCopyBackstoryDetail" style="border-color: {{accentColor}}22; background: {{accentColor}}06;">
            <text wx:if="{{card.formData.backstory_detail}}" class="backstory-preview-text">{{card.formData.backstory_detail}}</text>
            <text wx:else class="backstory-preview-placeholder">点击查看详细故事</text>
          </view>
        </view>
      </view>

      <!-- 背包 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">背包</text>
        </view>
        <view class="backstory-detail-section">
          <text class="backstory-detail-label">物品清单</text>
          <view class="backstory-detail-preview" bindtap="onBackpackPreview" bindlongpress="onCopyBackpack" style="border-color: {{accentColor}}22; background: {{accentColor}}06;">
            <text wx:if="{{card.formData.backpack}}" class="backstory-preview-text">{{card.formData.backpack}}</text>
            <text wx:else class="backstory-preview-placeholder">点击编辑背包</text>
          </view>
        </view>
      </view>

      <!-- 调查员经历 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">调查员经历</text>
          <text class="section-edit-btn" style="color: {{accentColor}};" bindtap="toggleExperienceManage">{{experienceManaging ? '✓ 完成' : '✎'}}</text>
        </view>
        <!-- 列标题 -->
        <view class="experience-header">
          <text class="experience-header-label">经历模组</text>
          <text class="experience-header-label">人物变化描述</text>
        </view>
        <view class="backstory-list">
          <view
            wx:for="{{experienceItems}}"
            wx:key="key"
            class="backstory-entry"
            style="border-color: {{accentColor}}15;"
          >
            <text
              class="experience-entry-label {{item.label ? '' : 'empty'}}"
              bindtap="{{experienceManaging ? '' : 'onExperienceLabelTap'}}"
              bindlongpress="onCopyExperienceEntry"
              data-key="{{item.key}}"
              data-label="{{item.label}}"
            >{{item.label || '暂无'}}</text>
            <view class="experience-entry-divider"></view>
            <text
              class="experience-entry-value"
              bindtap="{{experienceManaging ? '' : 'onExperienceValueTap'}}"
              bindlongpress="onCopyExperienceEntry"
              data-key="{{item.key}}"
              data-label="{{item.label}}"
            >{{item.value || '暂无'}}</text>
            <view wx:if="{{experienceManaging}}" class="exp-delete-btn" bindtap="onDeleteExperienceEntry" data-key="{{item.key}}" style="background: #ef4444;">
              <text>−</text>
            </view>
          </view>
        </view>
        <view class="add-entry-btn" bindtap="onAddExperienceEntry" style="border-color: {{accentColor}}33; color: {{accentColor}};">
          <text>+ 新增项目</text>
        </view>
      </view>
    </view>

    <!-- ============================================ -->
    <!-- DND 5e 冒险者卡 手动属性表 -->
    <!-- ============================================ -->
    <view wx:if="{{system === 'DND'}}" class="sheet-block">
      <!-- 基本信息 -->
      <view class="sheet-card" style="background: linear-gradient(135deg, {{accentColor}}18 0%, {{accentColor}}06 100%); border: 1px solid {{accentColor}}28;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">基本信息</text>
          <view class="section-edit-btns">
            <block wx:if="{{editingDndBasicInfo}}">
              <text class="section-edit-btn" bindtap="cancelDndBasicInfoEdit" style="color: {{accentColor}};">取消</text>
              <text class="section-edit-btn primary" bindtap="saveDndBasicInfo" style="color: {{accentColor}};">保存</text>
            </block>
            <text wx:else class="section-edit-btn" bindtap="onToggleDndBasicInfoEdit" style="color: {{accentColor}};">✎</text>
          </view>
        </view>
        <view wx:if="{{!editingDndBasicInfo}}" class="info-grid-2">
          <view class="info-row"><text class="info-label">姓名</text><text class="info-value">{{card.formData.name || '—'}}</text></view>
          <view class="info-row"><text class="info-label">玩家</text><text class="info-value">{{card.formData.player || '—'}}</text></view>
          <view class="info-row"><text class="info-label">职业</text><text class="info-value">{{card.formData.occupation || '—'}}</text></view>
          <view class="info-row"><text class="info-label">年龄</text><text class="info-value">{{card.formData.age || '—'}}</text></view>
          <view class="info-row"><text class="info-label">性别</text><text class="info-value">{{card.formData.gender || '—'}}</text></view>
          <view class="info-row"><text class="info-label">主职业</text><text class="info-value">{{dndClassLabel || '—'}}</text></view>
          <view class="info-row"><text class="info-label">等级</text><text class="info-value">{{card.formData.level || '—'}}</text></view>
          <view class="info-row"><text class="info-label">种族</text><text class="info-value">{{card.formData.race || '—'}}</text></view>
          <view class="info-row"><text class="info-label">阵营</text><text class="info-value">{{card.formData.alignment || '—'}}</text></view>
          <view class="info-row"><text class="info-label">背景</text><text class="info-value">{{card.formData.background || '—'}}</text></view>
        </view>
        <view wx:else class="dnd-edit-form">
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">姓名</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.name}}" data-key="name" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">玩家</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.player}}" data-key="player" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">职业</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.occupation}}" data-key="occupation" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">年龄</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.age}}" data-key="age" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">性别</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.gender}}" data-key="gender" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">主职业</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.class}}" data-key="class" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">等级</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.level}}" data-key="level" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">种族</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.race}}" data-key="race" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">阵营</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.alignment}}" data-key="alignment" bindinput="onDndBasicInfoInput" />
          </view>
          <view class="dnd-edit-row">
            <text class="dnd-edit-label">背景</text>
            <input class="dnd-edit-input" value="{{editDndBasicInfo.background}}" data-key="background" bindinput="onDndBasicInfoInput" />
          </view>
        </view>
      </view>

      <!-- 六项基础属性 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">基础属性</text>
          <view class="section-edit-btns">
            <block wx:if="{{editingDndAttrs}}">
              <text class="section-edit-btn" bindtap="cancelDndAttrEdit" style="color: {{accentColor}};">取消</text>
              <text class="section-edit-btn primary" bindtap="saveDndAttrs" style="color: {{accentColor}};">保存</text>
            </block>
            <text wx:else class="section-edit-btn" bindtap="onToggleDndAttrEdit" style="color: {{accentColor}};">✎</text>
          </view>
        </view>
        <view wx:if="{{!editingDndAttrs}}" class="dnd-attr-grid-v2">
          <view wx:for="{{dndAbilities}}" wx:key="key" class="dnd-attr-cell-v2" wx:for-item="attr">
            <text class="dnd-attr-label-v2">{{attr.label}}</text>
            <view class="dnd-attr-values-h">
              <view class="dnd-attr-col">
                <text class="dnd-attr-sub-label">调整</text>
                <text class="dnd-attr-mod-v2" style="color: {{attr.modColor}};">{{attr.mod}}</text>
              </view>
              <view class="dnd-attr-col dnd-attr-col-center">
                <text class="dnd-attr-score">{{attr.value}}</text>
              </view>
              <view class="dnd-attr-col">
                <text class="dnd-attr-sub-label">豁免</text>
                <text class="dnd-attr-save" style="color: {{attr.saveColor}};">{{attr.save}}</text>
              </view>
            </view>
            <text class="dnd-attr-abbr-v2">{{attr.abbr}}</text>
          </view>
        </view>
        <view wx:else class="dnd-edit-form">
          <view class="dnd-edit-header-row">
            <text class="dnd-edit-attr-label"></text>
            <view class="dnd-edit-attr-inputs">
              <text class="dnd-edit-input-label">属性值</text>
              <text class="dnd-edit-input-label">调整</text>
              <text class="dnd-edit-input-label">豁免</text>
            </view>
          </view>
          <view wx:for="{{dndAbilities}}" wx:key="key" class="dnd-edit-attr-row" wx:for-item="attr">
            <text class="dnd-edit-attr-label">{{attr.label}}</text>
            <view class="dnd-edit-attr-inputs">
              <input class="dnd-edit-attr-input" type="number" value="{{editDndAttrs[attr.key]}}" data-key="{{attr.key}}" bindinput="onDndAttrInput" />
              <input class="dnd-edit-attr-input" type="number" value="{{editDndAttrs[attr.key + '_mod']}}" data-key="{{attr.key}}_mod" bindinput="onDndAttrInput" />
              <input class="dnd-edit-attr-input" type="number" value="{{editDndAttrs[attr.key + '_save']}}" data-key="{{attr.key}}_save" bindinput="onDndAttrInput" />
            </view>
          </view>
        </view>
      </view>

      <!-- 当前状态 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <view class="sheet-card-header">
          <text class="sheet-card-title" style="color: {{accentColor}};">当前状态</text>
          <view class="section-edit-btns">
            <block wx:if="{{editingDndStatus}}">
              <text class="section-edit-btn" bindtap="cancelDndStatusEdit" style="color: {{accentColor}};">取消</text>
              <text class="section-edit-btn primary" bindtap="saveDndStatus" style="color: {{accentColor}};">保存</text>
            </block>
            <text wx:else class="section-edit-btn" bindtap="onToggleDndStatusEdit" style="color: {{accentColor}};">✎</text>
          </view>
        </view>
        <!-- 编辑模式 -->
        <view wx:if="{{editingDndStatus}}" class="stat-row-4">
          <view class="stat-card" style="background: linear-gradient(180deg, #ef444414 0%, #ef444406 100%); box-shadow: 0 0 0 1px #ef444433;">
            <view class="stat-edit-hp-row">
              <input class="stat-edit-hp-input hp-color" type="number" value="{{editDndStatus.hp}}" data-field="hp" bindinput="onDndStatusInput" />
              <text class="stat-edit-sep">/</text>
              <input class="stat-edit-hp-input" type="number" value="{{editDndStatus.hpMax}}" data-field="hpMax" bindinput="onDndStatusInput" />
            </view>
            <text class="stat-card-abbr">生命值 HP</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #f59e0b14 0%, #f59e0b06 100%); box-shadow: 0 0 0 1px #f59e0b33;">
            <input class="stat-edit-input" type="number" value="{{editDndStatus.initiative}}" data-field="initiative" bindinput="onDndStatusInput" />
            <text class="stat-card-abbr">先攻</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #8b5cf614 0%, #8b5cf606 100%); box-shadow: 0 0 0 1px #8b5cf633;">
            <view class="stat-edit-hp-row">
              <input class="stat-edit-hp-input" type="number" value="{{editDndStatus.hitDiceUsed}}" data-field="hitDiceUsed" bindinput="onDndStatusInput" />
              <text class="stat-edit-sep">/</text>
              <input class="stat-edit-hp-input" type="number" value="{{editDndStatus.hitDiceCount}}" data-field="hitDiceCount" bindinput="onDndStatusInput" />
            </view>
            <text class="stat-card-abbr">生命骰数量</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #22c55e14 0%, #22c55e06 100%); box-shadow: 0 0 0 1px #22c55e33;">
            <input class="stat-edit-input" value="{{editDndStatus.hitDice}}" data-field="hitDice" bindinput="onDndStatusInput" />
            <text class="stat-card-abbr">生命骰</text>
          </view>
        </view>
        <!-- 显示模式 -->
        <view wx:else class="stat-row-4">
          <view class="stat-card" style="background: linear-gradient(180deg, #ef444414 0%, #ef444406 100%); box-shadow: 0 0 0 1px #ef444433;">
            <text class="stat-card-val hp-color">{{card.formData.hp || '-'}}<text class="stat-card-max">/{{card.formData.hpMax || '-'}}</text></text>
            <text class="stat-card-abbr">生命值 HP</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #f59e0b14 0%, #f59e0b06 100%); box-shadow: 0 0 0 1px #f59e0b33;">
            <text class="stat-card-val">{{card.formData.initiative || '-'}}</text>
            <text class="stat-card-abbr">先攻</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #8b5cf614 0%, #8b5cf606 100%); box-shadow: 0 0 0 1px #8b5cf633;">
            <text class="stat-card-val">{{card.formData.hitDiceUsed || '-'}}<text class="stat-card-max">/{{card.formData.hitDiceCount || '-'}}</text></text>
            <text class="stat-card-abbr">生命骰数量</text>
          </view>
          <view class="stat-card" style="background: linear-gradient(180deg, #22c55e14 0%, #22c55e06 100%); box-shadow: 0 0 0 1px #22c55e33;">
            <text class="stat-card-val">{{card.formData.hitDice || '-'}}</text>
            <text class="stat-card-abbr">生命骰</text>
          </view>
        </view>
        <!-- 环位 -->
        <view class="spell-slots-section">
          <text class="spell-slots-title">环位</text>
          <view wx:if="{{editingDndStatus}}" class="spell-slots-grid">
            <view wx:for="{{dndSpellSlots}}" wx:key="index" class="spell-slot-edit">
              <text class="spell-slot-label">{{index + 1}}环</text>
              <view class="spell-slot-inputs">
                <input class="spell-slot-input" type="number" value="{{item.used}}" data-index="{{index}}" data-field="used" bindinput="onDndSpellSlotInput" />
                <text class="spell-slot-sep">/</text>
                <input class="spell-slot-input" type="number" value="{{item.total}}" data-index="{{index}}" data-field="total" bindinput="onDndSpellSlotInput" />
              </view>
            </view>
          </view>
          <view wx:else class="spell-slots-grid">
            <view wx:for="{{dndSpellSlots}}" wx:key="index" class="spell-slot-item">
              <text class="spell-slot-label">{{index + 1}}环</text>
              <text class="spell-slot-val">{{item.used || 0}}/{{item.total || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 豁免与技能 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <text class="sheet-card-title" style="color: {{accentColor}};">豁免 · 技能</text>
        <view wx:if="{{dndSavingThrows.length > 0}}" class="tag-section">
          <text class="tag-section-label">SAVING THROWS</text>
          <view class="tag-row">
            <view wx:for="{{dndSavingThrows}}" wx:key="key" class="tag-item" style="background: {{accentColor}}18; color: {{accentColor}}; border: 1px solid {{accentColor}}22;">{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{dndSkillProfs.length > 0}}" class="tag-section">
          <text class="tag-section-label">SKILL PROFICIENCIES</text>
          <view class="tag-row">
            <view wx:for="{{dndSkillProfs}}" wx:key="key" class="tag-item" style="background: {{accentColor}}10; color: {{accentColor}}; border: 1px solid {{accentColor}}18;">{{item.label}}</view>
          </view>
        </view>
      </view>

      <!-- 特性与专长 -->
      <view wx:if="{{card.formData.features}}" class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <text class="sheet-card-title" style="color: {{accentColor}};">特性与专长</text>
        <text class="story-text">{{card.formData.features}}</text>
      </view>

      <!-- 背景故事 -->
      <view wx:if="{{card.formData.backstory}}" class="sheet-card" style="background: linear-gradient(90deg, {{accentColor}}08 0%, transparent 100%); border-left: 3px solid {{accentColor}}55;">
        <view class="sheet-card-header">
          <text class="section-icon">⚔️</text>
          <text class="sheet-card-title" style="color: {{accentColor}};">背景故事</text>
        </view>
        <text class="story-text">{{card.formData.backstory}}</text>
      </view>
    </view>

    <!-- ============================================ -->
    <!-- Daggerheart 英雄卡 手动属性表 -->
    <!-- ============================================ -->
    <view wx:if="{{system === 'DAGGERHEART'}}" class="sheet-block">
      <!-- 基本信息 -->
      <view class="sheet-card" style="background: linear-gradient(135deg, {{accentColor}}15 0%, {{accentColor}}05 100%); border: 1px solid {{accentColor}}22;">
        <view class="dnd-id-row">
          <view class="dnd-id-icon" style="background: linear-gradient(135deg, {{accentColor}}20, {{accentColor}}0A); box-shadow: 0 0 0 2px {{accentColor}}33;">🗡️</view>
          <view class="dnd-id-info">
            <text class="dnd-id-name">{{card.formData.name || '无名英雄'}}</text>
            <view class="dnd-id-sub">
              <view class="dnd-level-tag" style="background: {{accentColor}}18; color: {{accentColor}};">阶层 {{card.formData.tier || '?'}}</view>
              <text class="dnd-id-race">{{card.formData.community || '?'}}</text>
            </view>
            <view class="dnd-id-extra">
              <text>Lv.{{card.formData.level || '?'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 六项属性 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <text class="sheet-card-title" style="color: {{accentColor}};">属性 · ATTRIBUTES</text>
        <view class="dh-attr-grid">
          <view wx:for="{{dhAttributes}}" wx:key="key" class="dh-attr-cell">
            <view class="dh-attr-top">
              <text class="dh-attr-label">{{item.label}}</text>
              <text class="dh-attr-abbr">{{item.abbr}}</text>
            </view>
            <text class="dh-attr-val" style="color: {{item.color}};">{{item.fmt}}</text>
            <view class="attr-bar-bg"><view class="attr-bar" style="width: {{item.barPct}}%; background: {{item.color}}; opacity: 0.5;"></view></view>
          </view>
        </view>
      </view>

      <!-- 耐力与压力 -->
      <view class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <text class="sheet-card-title" style="color: {{accentColor}};">耐力 · 压力 · STAMINA &amp; STRESS</text>
        <!-- 耐力 -->
        <view class="hp-bar-section">
          <view class="hp-bar-header">
            <text class="hp-bar-label">耐力 STAMINA</text>
            <text class="hp-bar-val" style="color: #22c55e;">{{card.formData.stamina || '-'}} / {{card.formData.staminaMax || '-'}}</text>
          </view>
          <view class="hp-bar-bg"><view class="hp-bar-fill" style="width: {{dhStaminaPct}}%; background: #22c55e; opacity: 0.7;"></view></view>
        </view>
        <!-- 压力 -->
        <view class="hp-bar-section">
          <view class="hp-bar-header">
            <text class="hp-bar-label">压力 STRESS</text>
            <text class="hp-bar-val" style="color: #ef4444;">{{card.formData.stress || '-'}} / {{card.formData.stressMax || '-'}}</text>
          </view>
          <view class="hp-bar-bg"><view class="hp-bar-fill" style="width: {{dhStressPct}}%; background: #ef4444; opacity: 0.7;"></view></view>
        </view>
      </view>

      <!-- 经验标记 -->
      <view wx:if="{{card.formData.experience}}" class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
        <text class="sheet-card-title" style="color: {{accentColor}};">经验标记 · EXPERIENCE</text>
        <text class="story-text">{{card.formData.experience}}</text>
      </view>

      <!-- 英雄过往 -->
      <view wx:if="{{card.formData.backstory}}" class="sheet-card" style="background: linear-gradient(90deg, {{accentColor}}08 0%, transparent 100%); border-left: 3px solid {{accentColor}}55;">
        <view class="sheet-card-header">
          <text class="section-icon">📖</text>
          <text class="sheet-card-title" style="color: {{accentColor}};">英雄过往</text>
        </view>
        <text class="story-text">{{card.formData.backstory}}</text>
      </view>
    </view>

    <!-- ============================================ -->
    <!-- 未知规则系统 -->
    <!-- ============================================ -->
    <view wx:if="{{system !== 'COC' && system !== 'DND' && system !== 'DAGGERHEART'}}" class="sheet-card" style="background: {{accentColor}}08; border: 1px solid {{accentColor}}15;">
      <view class="form-empty">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂不支持该规则系统的属性表展示</text>
      </view>
    </view>

    <view class="meta-info">
      <view class="meta-row">
        <text class="meta-label">创建时间</text>
        <text class="meta-value">{{createdAtText}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">最后更新</text>
        <text class="meta-value">{{updatedAtText}}</text>
      </view>
    </view>

    <view class="action-buttons" hidden>
      <view class="action-btn secondary" bindtap="exportCard">
        <text>📤 导出 JSON</text>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{cardNotFound}}" class="not-found">
  <text class="not-found-icon">🔍</text>
  <text class="not-found-text">未找到角色卡</text>
  <view class="not-found-btn" bindtap="goBack">返回列表</view>
</view>

<view wx:else class="not-found">
  <text class="not-found-icon">⏳</text>
  <text class="not-found-text">页面状态异常</text>
  <text class="not-found-desc">cardNotFound={{cardNotFound}}</text>
  <view class="not-found-btn" bindtap="goBack">返回列表</view>
</view>

<!-- st 指令对话框 -->
<view wx:if="{{stDialogVisible}}" class="dialog-mask" bindtap="closeStDialog">
  <view class="dialog-box" catchtap="stopPropagation">
    <view class="dialog-header">
      <text class="dialog-title">粘贴 .st 指令</text>
      <text class="dialog-close" bindtap="closeStDialog">✕</text>
    </view>
    <view class="dialog-body">
      <view class="dialog-tip">
        <text>粘贴 .st 指令，确认后将更新角色卡数据</text>
      </view>
      <view class="form-item">
        <textarea
          class="form-textarea st-textarea"
          placeholder="粘贴 .st 指令..."
          placeholder-class="input-placeholder"
          maxlength="-1"
          value="{{stCommandText}}"
          bindinput="onStCommandInput"
        />
      </view>
      <view class="dialog-actions">
        <view class="btn-cancel" bindtap="closeStDialog">取消</view>
        <view class="btn-primary" bindtap="applyStCommand">确认更新</view>
      </view>
    </view>
  </view>
</view>

<!-- 背景故事弹窗（独立弹窗，不嵌入角色卡内） -->
<view wx:if="{{backstoryDialogVisible}}" class="dialog-mask" bindtap="closeBackstoryDialog">
  <view class="dialog-box backstory-dialog" catchtap="stopPropagation">
    <view class="dialog-header">
      <text class="dialog-title">{{backstoryDialogTitle}}</text>
      <block wx:if="{{backstoryDialogEditing}}">
        <view class="dialog-header-actions">
          <text class="dialog-action-btn" bindtap="cancelBackstoryEdit">取消</text>
          <text class="dialog-action-btn primary" bindtap="applyBackstoryEdit">保存</text>
        </view>
      </block>
      <text wx:else class="backstory-edit-icon" bindtap="startBackstoryEdit">✎</text>
    </view>
    <view class="dialog-body">
      <textarea
        wx:if="{{backstoryDialogEditing}}"
        class="form-textarea backstory-textarea"
        placeholder="输入内容..."
        placeholder-class="input-placeholder"
        maxlength="-1"
        value="{{backstoryDialogContent}}"
        bindinput="onBackstoryDialogInput"
      />
      <text wx:else class="backstory-dialog-text">{{backstoryDialogContent || '暂无内容'}}</text>
    </view>
  </view>
</view>

<!-- 背包弹窗 -->
<view wx:if="{{backpackDialogVisible}}" class="dialog-mask" bindtap="closeBackpackDialog">
  <view class="dialog-box backstory-dialog" catchtap="stopPropagation">
    <view class="dialog-header">
      <text class="dialog-title">背包</text>
      <block wx:if="{{backpackDialogEditing}}">
        <view class="dialog-header-actions">
          <text class="dialog-action-btn" bindtap="cancelBackpackEdit">取消</text>
          <text class="dialog-action-btn primary" bindtap="applyBackpackEdit">保存</text>
        </view>
      </block>
      <text wx:else class="backstory-edit-icon" bindtap="startBackpackEdit">✎</text>
    </view>
    <view class="dialog-body">
      <textarea
        wx:if="{{backpackDialogEditing}}"
        class="form-textarea backstory-textarea"
        placeholder="输入背包物品..."
        placeholder-class="input-placeholder"
        maxlength="-1"
        value="{{backpackDialogContent}}"
        bindinput="onBackpackDialogInput"
      />
      <text wx:else class="backstory-dialog-text">{{backpackDialogContent || '暂无内容'}}</text>
    </view>
  </view>
</view>

<!-- 经历弹窗 -->
<view wx:if="{{experienceDialogVisible}}" class="dialog-mask" bindtap="closeExperienceDialog">
  <view class="dialog-box backstory-dialog" catchtap="stopPropagation">
    <view class="dialog-header">
      <text class="dialog-title">{{experienceDialogType === 'value' ? '人物变化描述' : '经历模组'}}</text>
      <block wx:if="{{experienceDialogEditing}}">
        <view class="dialog-header-actions">
          <text class="dialog-action-btn" bindtap="cancelExperienceEdit">取消</text>
          <text class="dialog-action-btn primary" bindtap="applyExperienceEdit">保存</text>
        </view>
      </block>
      <text wx:else class="backstory-edit-icon" bindtap="startExperienceEdit">✎</text>
    </view>
    <view class="dialog-body">
      <view wx:if="{{experienceDialogEditing}}">
        <input wx:if="{{experienceDialogType === 'label'}}" class="exp-edit-input" placeholder="经历模组" placeholder-class="input-placeholder" value="{{experienceDialogLabel}}" bindinput="onExperienceLabelInput" />
        <textarea wx:if="{{experienceDialogType === 'value'}}" class="form-textarea backstory-textarea" placeholder="人物变化描述" placeholder-class="input-placeholder" maxlength="-1" value="{{experienceDialogContent}}" bindinput="onExperienceDialogInput" />
      </view>
      <text wx:else class="backstory-dialog-text">{{experienceDialogType === 'value' ? (experienceDialogContent || '暂无内容') : (experienceDialogLabel || '暂无内容')}}</text>
    </view>
  </view>
</view>