{
  "compilerOptions": {
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": "./",
    "target": "ES6",
    "module": "CommonJS",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "typeRoots": [
      "./miniprogram/typings",
      "./typings"
    ]
  },
  "include": [
    "miniprogram/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "src"
  ]
}
